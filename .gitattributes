# ---------------------------------------------------------------------------
#  TexLab
# ---------------------------------------------------------------------------

# Normalise line endings for text, let Git detect the rest.
* text=auto

# ---------------------------------------------------------------------------
#  Unreal assets
#
#  'binary' is shorthand for '-text -diff'. Without it Git will try to detect
#  encoding, attempt line-ending conversion, and offer to merge these files.
#  A .uasset that has had CRLF conversion applied is corrupt, and a three-way
#  merge of one is never valid: the last-writer-wins, take-one-side rule is the
#  only correct resolution.
# ---------------------------------------------------------------------------

*.uasset  binary
*.umap    binary
*.upk     binary
*.udk     binary
*.uplugin text

# ---------------------------------------------------------------------------
#  Source
# ---------------------------------------------------------------------------

*.cpp  text diff=cpp
*.h    text diff=cpp
*.cs   text diff=csharp
*.usf  text
*.ush  text
*.ini  text
*.md   text
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# ---------------------------------------------------------------------------
#  If the baked textures ever do need to be tracked, uncomment these and run
#  'git lfs install' first. Do it BEFORE the first commit that adds them:
#  converting existing history to LFS means rewriting it.
# ---------------------------------------------------------------------------

# *.uasset filter=lfs diff=lfs merge=lfs -text
