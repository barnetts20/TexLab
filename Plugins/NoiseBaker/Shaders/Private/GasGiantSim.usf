// ---------------------------------------------------------------------------
// Gas giant flow sim. Vorticity-streamfunction on a sphere, in sin(latitude).
//
// WHAT THIS REPLACES AND WHY.
//
// The kinematic model wound isotropic noise with a prescribed differential
// rotation. That is a defensible model of the process -- banding really is
// anisotropic straining of isotropic structure -- but it has no mechanism to
// sustain anything. Shear only ever stretches, so every vortex is eventually
// drawn into a filament and lost, which is why spots had to be exempted from
// the shear by hand and why the whole crossfade apparatus existed to bound
// winding that would otherwise run away.
//
// A vorticity solve has the mechanism. Two-dimensional turbulence cascades
// energy UPWARD in scale, so eddies merge and grow instead of shredding, and
// vortices persist because they are being fed rather than because they were
// excluded from the flow.
//
// THE STEP ORDER, WHICH IS NOT ARBITRARY.
//
//   Velocity   u = N x grad(psi) from the current psi. Also writes the texture
//              the material samples, so this pass serves both.
//   Advect     Semi-Lagrangian on ABSOLUTE vorticity.
//   Reduce     Row means, then the global mean.
//   Force      Nudge the zonal mean, force the eddies, drag, layer coupling,
//              and project out the global mean.
//   Filter     Longitudinal box filter in the polar rows.
//   Poisson    Red-black SOR for the new psi, warm-started from the old one.
//
// Velocity comes first because advection needs a velocity consistent with the
// vorticity it is advecting. Reduce comes after advect because the forcing
// nudges what the flow has actually become, not what it was at the top of the
// step.
//
// EVERYTHING IS NON-DIMENSIONAL ON A UNIT SPHERE.
//
// No planet radius appears anywhere. Velocities are angular rates in radians
// per unit time, which is the same unit GG_ZonalRate already produced, so the
// sim's output and the material's jet profile are commensurate by construction.
// This is deliberate: the last time two quantities in this system were combined
// without a shared unit it cost hours and presented as a mystery gain of
// several hundred. Here there is no conversion to get wrong because there is no
// conversion.
//
// TIME UNITS. One unit of time is whatever GG_ZonalRate's radians are per. If
// JetStrength is 0.1 then a jet crosses one radian in ten units, so a timestep
// of 0.02 moves the fastest jet about 0.002 rad, which against a 512-column
// grid (0.0123 rad at the equator) is a Courant number near 0.16. Comfortable.
// ---------------------------------------------------------------------------

#include "/Engine/Public/Platform.ush"
#include "/Plugin/NoiseBaker/Private/GasGiantJets.ush"
#include "/Plugin/NoiseBaker/Private/GasGiantSimCommon.ush"

// -- Shared parameters ------------------------------------------------------
//
// Declared at file scope and consumed by whichever kernels need them. Each
// kernel's C++ FParameters struct should declare only the subset it actually
// binds; anything declared there and unused here is stripped by the compiler
// and shows up as an unbound parameter warning, which is the signal that the
// struct and the kernel have drifted apart.

/** x BandCount, y JetStrength, z EquatorialBoost, w Asymmetry. */
float4 SimJetParams;

/** xyz BandShape (Flatness, WidthBias, ReliefThinning). w unused here. */
float4 SimBandShape;

/** Per layer: x JetScale, y BoostScale, z ForcingScale, w DragScale.
 *
 *  THIS IS THE VERTICAL WIND SHEAR. Taylor-Proudman makes the flow invariant
 *  along the rotation axis, so a 3D solve is mostly wasted -- columns move
 *  together. What a stack of 2D layers buys that a single layer does not is
 *  layers that disagree, and JetScale is how they disagree: a deeper layer with
 *  a weaker or wider profile produces genuine shear against the layer above it,
 *  and the material reads the difference as depth.
 *
 *  All four are MULTIPLIERS on the shared profile rather than independent
 *  profiles. Independent profiles would let the layers' jets sit at different
 *  latitudes, and then the bands drawn from the shared profile would register
 *  with none of them. */
float4 SimLayerProfile[8];

float SimDeltaTime;
float SimTime;

/** 2 * Omega, the planetary vorticity coefficient. f = SimPlanetaryVorticity * mu.
 *
 *  BETA IS NOT OPTIONAL, and it is this one number.
 *
 *  Jets exist because the Coriolis parameter VARIES with latitude. That
 *  gradient makes the inverse cascade anisotropic -- north-south motion
 *  radiates Rossby waves and east-west motion does not -- so energy is fed
 *  preferentially into zonal modes and the cascade arrests at the Rhines scale
 *  instead of running to the domain scale.
 *
 *  Set this to zero and the cascade is isotropic: eddies still merge, but they
 *  merge into one planet-sized vortex rather than into jets. There is no
 *  banding, at all, and no amount of forcing or tuning produces any. With
 *  prescribed jets the nudge would paper over it and the field would look
 *  roughly right while being driven entirely by the nudge, which is the version
 *  of this failure that survives review.
 *
 *  Physically this should be several times JetStrength: Jupiter's rotation
 *  dominates its winds by roughly two orders of magnitude, and the ratio is
 *  what sets the Rhines scale and therefore how many bands emerge without being
 *  told to. */
float SimPlanetaryVorticity;

// -- Resources --------------------------------------------------------------

Texture2DArray<float> SimVorticitySRV;
Texture2DArray<float> SimPsiSRV;
Texture2DArray<float4> SimVelocitySRV;

RWTexture2DArray<float> SimVorticityUAV;
RWTexture2DArray<float> SimPsiUAV;
RWTexture2DArray<float4> SimVelocityUAV;

/** Zonal mean of vorticity, (row, layer). */
Texture2D<float> SimRowMeanSRV;
RWTexture2D<float> SimRowMeanUAV;

/** Area mean of vorticity over the whole sphere, (0, layer). */
Texture2D<float> SimGlobalMeanSRV;
RWTexture2D<float> SimGlobalMeanUAV;

/** Baked tiling scalar noise. Used twice, for different jobs, and it is worth
 *  being clear that they are different jobs: at init it is the streamfunction
 *  of the seed eddies, and during the run it is the stochastic forcing.
 *
 *  This is what volume A becomes. It is no longer a vector field bake and no
 *  longer needs the gradient, the RGBA16F format or the PotentialGradientScale
 *  reconciliation, because nothing differentiates it analytically any more --
 *  the grid does that. One smooth scalar channel. */
Texture3D<float4> SimSeedNoise;
SamplerState SimSeedNoiseSampler;

/** Which channel of the seed volume to read. */
int SimSeedChannel;

/** Channel carrying the small-scale stochastic forcing.
 *
 *  SEPARATE FROM THE SEED CHANNEL BECAUSE THEY WANT OPPOSITE THINGS.
 *
 *  The seed is a STREAMFUNCTION and gets differentiated twice, so a Laplacian
 *  amplifies it by k^2 and it is dominated by the finest scale present. It
 *  wants coarse, smooth, few octaves.
 *
 *  The forcing is added straight to omega with no differentiation at all, and
 *  wants to sit at a SMALL scale -- well below the Rhines wavelength -- so the
 *  inverse cascade has room to organise it into something larger.
 *
 *  Sharing one channel forces a compromise that is wrong for both: coarse
 *  enough to seed cleanly is too coarse to force with, and fine enough to force
 *  with seeds grid-scale hash that the advection removes in a handful of steps. */
int SimForcingChannel;

/** 1 when the baked channel is stored SIGNED, 0 when it is unipolar [0,1].
 *
 *  The decode below recentres a unipolar bake with x*2-1. Applied to a channel
 *  baked with bBipolarOutput -- which RGBA16F stores directly, with an identity
 *  decode -- that maps [-1,1] onto [-3,1]: asymmetric, biased, and with double
 *  the intended amplitude. As a streamfunction that is a large spurious
 *  circulation; as forcing it is a constant vorticity source with noise on top.
 *
 *  Worth an explicit flag rather than an assumption because the seed volume
 *  SHOULD be bipolar RGBA16F, so the wrong branch is the one that looks like
 *  the default. */
int SimSeedBipolar;

/** Zero when no seed volume is bound.
 *
 *  Needed because the decode below recentres a unipolar bake, and a missing
 *  volume binds black, which decodes to a CONSTANT -1 rather than to nothing.
 *  In the initial condition that is harmless -- a constant added to psi has no
 *  gradient -- but in the forcing it is a uniform negative vorticity source
 *  applied every step, cancelled only one step late by the global-mean
 *  subtraction, which uses the previous step's mean.
 *
 *  So an unseeded run was never actually unforced, which quietly invalidates
 *  the one test that is supposed to have an exactly known answer: a purely
 *  zonal field held perfectly static. */
int SimHasSeed;

/** Amplitude of the seeded eddy streamfunction, relative to the zonal one. */
float SimEddyAmplitude;

/** Domain scale for the seed lookup. This sets the SIZE of the seeded eddies
 *  and therefore the scale the inverse cascade starts from; it should sit
 *  comfortably below the Rhines scale the jets imply, or the seed is already
 *  larger than the structures the flow can support and the sim spends its
 *  spin-up taking it apart. */
float SimSeedScale;

// -- Helpers ----------------------------------------------------------------

/** Per-layer jet profile. Layer 0 is the visible top deck. */
void SimLayerJets(uint Layer, out float BandCount, out float JetStrength, out float Boost, out float Asymmetry)
{
    const float4 Profile = SimLayerProfile[min(Layer, 7u)];

    BandCount = SimJetParams.x;
    JetStrength = SimJetParams.y * Profile.x;
    Boost = SimJetParams.z * Profile.y;
    Asymmetry = SimJetParams.w;
}

/** Planetary vorticity at this latitude. */
float SimPlanetary(float Mu)
{
    return SimPlanetaryVorticity * Mu;
}

float SimSampleSeed(float3 UVW, int Channel)
{
    if (SimHasSeed == 0)
    {
        return 0.0f;
    }

    const float4 S = SimSeedNoise.SampleLevel(SimSeedNoiseSampler, UVW, 0.0f);

    const float Raw = (Channel == 0) ? S.r
		: (Channel == 1) ? S.g
		: (Channel == 2) ? S.b : S.a;

	// Identity for a signed bake, recentre for a unipolar one. Both consumers
	// want a field centred on zero: a streamfunction with a DC offset is a
	// constant added to psi, which is harmless, but a forcing with a DC offset
	// is a uniform vorticity source, which is not.
    return (SimSeedBipolar != 0) ? Raw : (Raw * 2.0f - 1.0f);
}

bool SimOutOfBounds(uint3 Id)
{
    return any(int3(Id) >= SimGridSize);
}

// ---------------------------------------------------------------------------
// Initialisation
//
// WHY THE INITIAL STATE IS CONSTRUCTED RATHER THAN SPUN UP FROM REST.
//
// The expensive part of a real spin-up is the part this does not need. What
// takes thousands of turnover times is the inverse cascade organising jets out
// of isotropic forcing, and the jets here are prescribed, so that entire phase
// is skipped. What remains is eddies finding a self-consistent relationship
// with jets that already exist, and that takes tens of turnovers.
//
// Seeding with STRUCTURE rather than with small random noise is the other half.
// From noise, the sim has to wait for shear instability to grow eddies out of
// nothing, which is slow and exponential. From a field that already contains
// vortices at roughly the right scale, it only has to make them consistent.
//
// Together those turn a spin-up of thousands of steps into a few hundred, which
// at sub-millisecond each is a fraction of a second of streaming-in cost. Which
// in turn means baking the converged state is OPTIONAL -- worth doing at ship
// time if a planet must look identical every session, but during development
// running it at load keeps BandCount, JetStrength, Asymmetry and
// EquatorialBoost live parameters instead of things that need a re-bake before
// they can be seen.
// ---------------------------------------------------------------------------

/** Zonal streamfunction per row, by quadrature.
 *
 *  psi_zonal(mu) = -integral of R(mu') dmu' from -1 to mu, since for a zonal
 *  flow of angular rate R the relation u_east = -cos(phi) dpsi/dmu with
 *  u_east = R cos(phi) gives dpsi/dmu = -R directly.
 *
 *  Done as a per-row 1D pass rather than per texel because it is a 1D integral
 *  and computing it redundantly for every column would be N_lon times the work
 *  for an identical answer.
 *
 *  Midpoint rule on the grid's own rows, so the discrete psi it produces is
 *  consistent with the discrete Laplacian that will later invert it. Consistency
 *  matters more here than order of accuracy: the point is that the first Poisson
 *  solve should have almost nothing to do.
 *
 *  Dispatch (N_lat, LayerCount, 1). */
[numthreads(64, 1, 1)]
void MainInitZonalPotentialCS(uint3 Id : SV_DispatchThreadID)
{
    const int Row = (int) Id.x;
    const uint Layer = Id.y;

    if (Row >= SimGridSize.y || (int) Layer >= SimGridSize.z)
    {
        return;
    }

    float BandCount, JetStrength, Boost, Asymmetry;
    SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

    const float DMu = 2.0f * SimInvGridSize.y;

    float Psi = 0.0f;

	[loop]
    for (int J = 0; J <= Row; J++)
    {
        const float Mu = SimRowToMu((float) J);
        const float R = GG_ZonalRate(Mu, BandCount, JetStrength, Boost, Asymmetry, SimBandShape.xyz);

		// Half weight on the row being written, so the accumulated value lands
		// at the texel CENTRE rather than at its upper face. Getting this wrong
		// offsets psi by half a row, which puts the jets half a band off the
		// vorticity that is supposed to be producing them.
        const float Weight = (J == Row) ? 0.5f : 1.0f;

        Psi -= R * DMu * Weight;
    }

	// Written into the row-mean buffer, which is idle at init and has exactly
	// the right shape. Called out because a per-row streamfunction living in
	// something named RowMean reads as a copy-paste error otherwise; it is not,
	// and the alternative is a second (N_lat x Layers) resource allocated for
	// the lifetime of the sim to be used once.
    SimRowMeanUAV[int2(Row, Layer)] = Psi;
}

/** Streamfunction seed: the zonal part plus band-limited eddies.
 *
 *  The eddy part is the baked scalar read as a STREAMFUNCTION, which is the
 *  composite-potential idea finally in its right place -- as an initial
 *  condition rather than as the final answer.
 *
 *  ONE SUBTLETY THAT DECIDES WHETHER THE SEED SURVIVES: the eddy volume wants
 *  FEW octaves, not many. Vorticity is the Laplacian of this, and a Laplacian
 *  is a k^2 amplifier, so it is dominated by the smallest scale present rather
 *  than the largest. Seed with a volume carrying octaves down to the texel and
 *  the resulting vorticity is grid-scale hash, which the advection diffuses
 *  away within a handful of steps -- so the sim arrives at a bland zonal field
 *  quickly and it looks exactly as though the seeding did nothing.
 *
 *  A coarse base period and two or three octaves puts the seed's energy at the
 *  eddy scale, which is what should survive. Resolution can go UP freely, since
 *  this volume is now read once at init and has left the per-pixel path
 *  entirely; it is octave count that has to come down.
 *
 *  Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainInitPotentialCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);

    const float3 N = SimDirection(Lon, Mu);

	// Decorrelating offset per layer so the stack does not start as three
	// copies of one eddy field at different strengths, which would couple into
	// a single columnar structure and lose the vertical shear the stack exists
	// to provide.
    const float3 UVW = N * SimSeedScale + float3(0.37f, 0.61f, 0.23f) * (float) Layer;

    const float ZonalPsi = SimRowMeanSRV.Load(int3(C.y, Layer, 0));

	// EDDY AMPLITUDE IS A VELOCITY RATIO, NOT A STREAMFUNCTION AMPLITUDE.
	//
	// Velocity is the curl of psi, so it carries one derivative and scales as
	// k * psi. The seed is read at N * SeedScale with N a unit vector, so one
	// noise period spans 1/SeedScale radians of arc and the angular wavenumber
	// is k = 2 pi * SeedScale.
	//
	// Scaling psi directly therefore makes the eddy SPEED proportional to
	// SeedScale, which is the wrong coupling in the worst way: changing the
	// eddy SIZE silently changes the eddy STRENGTH, so tuning either one
	// detunes the other and neither converges. At SeedScale 4 the factor is
	// about 25, which is how a nominal amplitude of 0.05 produced eddies twelve
	// times faster than the jets -- a field with no visible banding at step
	// zero, before any instability had a chance to act.
	//
	// Dividing it back out makes the parameter mean what its name says: 1.0 is
	// eddies at roughly jet speed, 0.25 is a quarter of it. SeedScale then
	// controls size alone and the two are independent.
	//
	// APPROXIMATE, and worth knowing where. It uses the seed's BASE wavenumber,
	// but a multi-octave bake has most of its gradient in the finest octave, so
	// a volume with several octaves is stronger than this predicts by roughly
	// the octave span. That is the other reason the seed wants few octaves.
    const float EddyK = 2.0f * PI * max(SimSeedScale, 1e-3f);
    const float EddyPsi = SimEddyAmplitude * SimJetParams.y / EddyK;

    SimPsiUAV[int3(C, Layer)] = ZonalPsi + EddyPsi * SimSampleSeed(UVW, SimSeedChannel);
}

/** Vorticity from the seeded streamfunction, through the SAME discrete
 *  operator the solver will later invert.
 *
 *  Not the analytic vorticity, deliberately. Taking the grid Laplacian of the
 *  grid streamfunction puts the initial vorticity exactly in the RANGE of the
 *  discrete operator, so the first Poisson solve reproduces the seed psi to
 *  round-off and the sim starts in equilibrium with itself. Seeding with the
 *  continuum expression instead leaves a truncation-sized residual everywhere,
 *  and the solver spends its first several steps radiating that away as a
 *  transient -- which at high latitude, where the operator is stiffest, looks
 *  like a ring of spurious circulation appearing and then decaying.
 *
 *  Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainInitVorticityCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    float Diagonal;
    SimVorticityUAV[int3(Id)] = SimLaplacian(SimPsiSRV, int2(Id.xy), Id.z, Diagonal);
}

// ---------------------------------------------------------------------------
// Velocity, and the texture the material reads
// ---------------------------------------------------------------------------

/** Writes float4(velocity.xyz, psi).
 *
 *  VELOCITY IN RGB RATHER THAN A GRADIENT TO BE CROSSED WITH THE NORMAL.
 *
 *  The material used to read a baked grad(psi), project it tangentially, cross
 *  it with N and multiply by a hand-calibrated constant to convert a normalized
 *  [-1,1] channel into an angular rate. All four of those steps disappear. The
 *  sim knows the velocity in physical units, it is already tangent, and writing
 *  it directly means the unit conversion cannot be got wrong because it does not
 *  exist.
 *
 *  PSI IN ALPHA IS THE PRESSURE CHANNEL. cross(N, grad psi) is the geostrophic
 *  relation, so the circulation around a high or a low is not decorated on
 *  afterwards -- psi and the velocity come from the same field, and vortex
 *  centres in alpha are exactly the places the RGB circulates around. That is
 *  what makes GG_CloudTop's pressure lift land on the actual storms.
 *
 *  RGBA16F. Velocity components are O(JetStrength), psi is O(JetStrength), and
 *  half precision is roughly three decimal digits there -- far finer than the
 *  material's own filtering. Full float would double the bandwidth of the one
 *  resource that is read per pixel.
 *
 *  Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainVelocityCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float DLon = (2.0f * PI) * SimInvGridSize.x;
    const float DMu = 2.0f * SimInvGridSize.y;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);
    const float CosPhi = sqrt(1.0f - Mu * Mu);

	// Taps inline rather than through a shared helper. There is exactly one
	// consumer of the streamfunction gradient, so a helper in the common header
	// would be a second entry point that nothing calls -- and the last one that
	// existed had to be deleted for precisely that reason.
    const float Psi = SimLoad(SimPsiSRV, C, Layer);

    const float West = SimLoad(SimPsiSRV, C + int2(-1, 0), Layer);
    const float East = SimLoad(SimPsiSRV, C + int2(1, 0), Layer);
    const float South = SimLoad(SimPsiSRV, C + int2(0, -1), Layer);
    const float North = SimLoad(SimPsiSRV, C + int2(0, 1), Layer);

	// u = N x grad(psi), which on the sphere gives
	//     u_east  = -cos(phi) dpsi/dmu
	//     u_north =  (1/cos(phi)) dpsi/dlambda
	//
	// Centred differences, both through SimWrapCoord, so the longitude one is
	// correct at the seam and the mu one is one-sided across the pole by way of
	// the mirror -- which is the right thing there, since the mirrored value is
	// the real field on the far side rather than a boundary approximation.
	//
	// The 1/cos(phi) on the north component is the one genuinely singular term
	// in the velocity. It is bounded on a cell-centred grid and bounded further
	// by the zonal filter, which is what keeps it off the CFL at high latitude.
    const float UEast = -CosPhi * ((North - South) / (2.0f * DMu));
    const float UNorth = ((East - West) / (2.0f * DLon)) / CosPhi;

    const float3 Velocity = SimEast(Lon) * UEast + SimNorth(Lon, Mu) * UNorth;

    SimVelocityUAV[int3(C, Layer)] = float4(Velocity, Psi);
}

// ---------------------------------------------------------------------------
// Advection
// ---------------------------------------------------------------------------

/** Semi-Lagrangian advection of ABSOLUTE vorticity q = omega + f.
 *
 *  Absolute rather than relative, and this is where beta enters. Relative
 *  vorticity is not materially conserved on a rotating sphere; absolute
 *  vorticity is. Advecting omega alone and hoping the jets carry the anisotropy
 *  loses the Rossby wave restoring force entirely, and with it the arrest of
 *  the cascade.
 *
 *  Written as: sample q at the departure point, subtract f at the ARRIVAL
 *  point. A parcel that moved poleward arrives with the f it had where it came
 *  from, so its relative vorticity must drop to compensate -- that difference
 *  IS the beta effect, and it falls out of the bookkeeping rather than needing
 *  a separate term.
 *
 *  THE BACKTRACE IS AN EXACT GREAT-CIRCLE ROTATION, not normalize(N - u dt).
 *
 *  Displacing along the tangent and renormalizing moves along a CHORD, which is
 *  short by a factor of cos(theta) and drags the departure point toward the
 *  starting latitude. The error is third order in one step and would be
 *  tolerable in isolation, but it is systematic and it accumulates over
 *  hundreds of steps into a slow poleward-or-equatorward creep of everything
 *  the flow carries. The exact form costs one sincos per texel per step, which
 *  at grid resolution is nothing, and is correct for any step size.
 *
 *  With a = N x u_hat, the frame {N, u_hat, a} is orthonormal and a x N is
 *  u_hat, so Rodrigues collapses to two terms.
 *
 *  Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainAdvectCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);
    const float3 N = SimDirection(Lon, Mu);

    const float3 Velocity = SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).xyz;

    const float Speed = length(Velocity);

    float3 Departure = N;

    if (Speed > 1e-8f)
    {
        const float3 UHat = Velocity / Speed;
        const float Theta = Speed * SimDeltaTime;

        float SinT, CosT;
        sincos(Theta, SinT, CosT);

		// Backward along the great circle: forward is N cos + UHat sin.
        Departure = normalize(N * CosT - UHat * SinT);
    }

    const float2 Grid = SimDirectionToGrid(Departure);

	// mu at the departure point is just its z component. No asin, and no
	// dependence on the interpolation, so the planetary vorticity being
	// subtracted is exact rather than reconstructed.
    const float QDeparture = SimSampleCubic(SimVorticitySRV, Grid, Layer) + SimPlanetary(Departure.z);

    SimVorticityUAV[int3(C, Layer)] = QDeparture - SimPlanetary(Mu);
}

// ---------------------------------------------------------------------------
// Reductions
//
// Both are trivially cheap because the grid is equal-area: a zonal mean is a
// plain row mean and the global mean is a plain mean of row means, with no area
// weights anywhere. On any other spherical grid both would carry a cos(phi) or
// a Jacobian, and getting one of those slightly wrong produces a global mean
// that is slightly nonzero, which the Poisson solve then cannot satisfy.
// ---------------------------------------------------------------------------

/** Dispatch (N_lat, LayerCount, 1). */
[numthreads(64, 1, 1)]
void MainReduceRowsCS(uint3 Id : SV_DispatchThreadID)
{
    const int Row = (int) Id.x;
    const uint Layer = Id.y;

    if (Row >= SimGridSize.y || (int) Layer >= SimGridSize.z)
    {
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int I = 0; I < SimGridSize.x; I++)
    {
        Sum += SimVorticitySRV.Load(int4(I, Row, Layer, 0));
    }

    SimRowMeanUAV[int2(Row, Layer)] = Sum * SimInvGridSize.x;
}

/** Dispatch (LayerCount, 1, 1). */
[numthreads(8, 1, 1)]
void MainReduceGlobalCS(uint3 Id : SV_DispatchThreadID)
{
    const uint Layer = Id.x;

    if ((int) Layer >= SimGridSize.z)
    {
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int J = 0; J < SimGridSize.y; J++)
    {
        Sum += SimRowMeanSRV.Load(int3(J, Layer, 0));
    }

    SimGlobalMeanUAV[int2(0, Layer)] = Sum * SimInvGridSize.y;
}

// ---------------------------------------------------------------------------
// Forcing
// ---------------------------------------------------------------------------

/** Nudging strength toward the prescribed zonal profile, per unit time.
 *
 *  PRESCRIBED AND EMERGENT ARE NOT A FORK. Both are a source term on omega, and
 *  they differ only in what gets added, so both are written here with
 *  independent coefficients rather than as two code paths.
 *
 *  Ship the first version with this high and SimForcingAmplitude at zero. That
 *  makes the profile hold still, which is what lets advection be validated
 *  against a passive tracer and the Poisson solve against a known harmonic,
 *  independently, with a known answer. Then walk this down and the forcing up.
 *  If jets fail to survive, that is a bisection between two working halves
 *  rather than a blank screen.
 *
 *  Note what is nudged: the zonal MEAN, not the field. Nudging the field would
 *  erase every eddy each step and the sim would be an expensive way to evaluate
 *  GG_ZonalRate. */
float SimNudgeRate;

/** Stochastic small-scale forcing. The physics note at the top of
 *  GasGiantFlow.ush says the forcing is isotropic, and a tiling band-limited
 *  noise volume sampled at a drifting position is exactly that: isotropic,
 *  band-limited at a chosen wavenumber, and temporally decorrelating for free.
 *
 *  This is the other job volume A now does. It stopped being the flow and
 *  became what drives the flow. */
float SimForcingAmplitude;
float SimForcingScale;
float3 SimForcingDrift;

/** Linear drag on the EDDY part of the vorticity, per unit time.
 *
 *  Two-dimensional turbulence needs a large-scale sink or energy accumulates at
 *  the domain scale and the field ends as one hemispheric vortex. Linear drag
 *  on omega is that sink: it damps all vorticity scales equally, which in
 *  ENERGY terms is weighted as 1/k^2 and therefore bites hardest exactly at the
 *  largest scales, which is where the arrest is wanted.
 *
 *  Applied to the eddy part only, since the zonal mean has its own explicit
 *  nudge and dragging it as well would just fight that. */
float SimDragRate;

/** Relaxation between vertically adjacent layers, per unit time.
 *
 *  Weak, deliberately. Taylor-Proudman says columns move together, so strong
 *  coupling is the physically correct limit -- and it is also the limit in which
 *  the stack collapses to one layer and buys nothing. The interesting regime is
 *  coupling weak enough that layers retain distinct jets and hence real vertical
 *  shear, but not zero, so that a vortex in one layer leaves an impression in
 *  the next and the stack reads as one atmosphere rather than as three
 *  transparencies.
 *
 *  This is a crude stand-in for the interface term in a proper two-layer
 *  quasi-geostrophic model, which would couple the layers through the Poisson
 *  solve itself and would give baroclinic instability as a genuine eddy source.
 *  That is the upgrade, and it is a real one; this is not it. */
float SimLayerCoupling;

/** Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainForceCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Lon = SimColumnToLon((float) C.x);
    const float Mu = SimRowToMu((float) C.y);

    const float4 Profile = SimLayerProfile[min(Layer, 7u)];

    float Omega = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));

    const float ZonalMean = SimRowMeanSRV.Load(int3(C.y, Layer, 0));
    const float Eddy = Omega - ZonalMean;

	// -- Zonal nudge --------------------------------------------------------

    float BandCount, JetStrength, Boost, Asymmetry;
    SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

    const float Target = GG_ZonalVorticity(Mu, BandCount, JetStrength, Boost, Asymmetry, SimBandShape.xyz);

    Omega += SimNudgeRate * SimDeltaTime * (Target - ZonalMean);

	// -- Stochastic forcing -------------------------------------------------

    const float3 N = SimDirection(Lon, Mu);
    const float3 ForcingUVW = N * SimForcingScale
		+ SimForcingDrift * SimTime
		+ float3(0.13f, 0.29f, 0.71f) * (float) Layer;

	// FORCING AMPLITUDE IS AN EQUILIBRIUM, NOT A RATE.
	//
	// This is a forced-dissipative balance. With a slowly varying forcing F and
	// linear drag, d(omega)/dt = F - Drag*omega settles at omega = F/Drag, so a
	// raw amplitude sets the eddy strength only in combination with the drag --
	// and drag is the primary handle for arresting the cascade, so every time
	// it is touched the eddies silently retune.
	//
	// Multiplying by the drag rate here cancels that: the parameter becomes the
	// equilibrium eddy vorticity directly, and stays put while drag is tuned.
	// Compare it against the zonal vorticity scale, roughly
	// JetStrength * 0.69 * BandCount * pi, which is what the bands are made of.
	//
	// Consequence worth knowing: at DragRate zero there is no forcing, because
	// there is no equilibrium to aim at. That is the honest answer rather than
	// an edge case -- unforced and undamped is a different model.
    const float ForcingRate = SimForcingAmplitude * SimDragRate * Profile.z;

    Omega += ForcingRate * SimDeltaTime * SimSampleSeed(ForcingUVW, SimForcingChannel);

	// -- Vertical coupling --------------------------------------------------

    if (SimLayerCoupling > 0.0f && SimGridSize.z > 1)
    {
		// AVERAGE ONLY GENUINE NEIGHBOURS.
		//
		// Clamping the neighbour index at the ends makes an end layer average
		// with ITSELF, and the self term cancels half of (Neighbour - Omega).
		// So layer 0 and the deepest layer relax at half the authored rate
		// while the interior relaxes at the full rate -- a vertical asymmetry
		// that is invisible in the parameter and shows up as the top and bottom
		// of the stack behaving differently from the middle for no stated
		// reason. Layer 0 is the visible deck, so it is the one that is wrong.
        const int Last = SimGridSize.z - 1;
        const int Self = (int) Layer;

        float Sum = 0.0f;
        float Count = 0.0f;

        if (Self > 0)
        {
            Sum += SimVorticitySRV.Load(int4(C.x, C.y, Self - 1, 0));
            Count += 1.0f;
        }

        if (Self < Last)
        {
            Sum += SimVorticitySRV.Load(int4(C.x, C.y, Self + 1, 0));
            Count += 1.0f;
        }

		// Count is at least one, since the enclosing branch guarantees more
		// than one layer exists.
        const float Neighbour = Sum / Count;

        Omega += SimLayerCoupling * SimDeltaTime * (Neighbour - Omega);
    }

	// -- Drag ---------------------------------------------------------------

    Omega -= SimDragRate * Profile.w * SimDeltaTime * Eddy;

	// -- Solvability --------------------------------------------------------

	// The Poisson problem on a CLOSED surface is solvable only if the source
	// integrates to zero, because the integral of a Laplacian over a closed
	// manifold is identically zero and no psi can produce a source that does
	// not share that property.
	//
	// Analytically the vorticity does integrate to zero. Numerically it drifts,
	// because interpolation is not conservative and the forcing terms above are
	// not mean-free. A source with a nonzero mean does not make the solver
	// crash -- it makes it fail to converge, slowly, and the residual it cannot
	// remove shows up as psi growing without bound over minutes of runtime.
	// That is an exceptionally annoying bug to find from the symptom.
	//
	// Projecting the mean out costs one subtraction and makes it impossible.
    Omega -= SimGlobalMeanSRV.Load(int3(0, Layer, 0));

    SimVorticityUAV[int3(C, Layer)] = Omega;
}

// ---------------------------------------------------------------------------
// Polar filter
// ---------------------------------------------------------------------------

float SimFilterLatitude;
int SimFilterMaxHalfWidth;


/** Longitudinal box filter, widening toward the poles. See SimFilterHalfWidth
 *  for why this exists and what the rejected alternative was.
 *
 *  A box rather than a Gaussian: the cutoff is crude in wavenumber, but the
 *  quantity being enforced is a resolution limit rather than a spectrum, and a
 *  box of width 1/cos(phi) restores uniform effective spacing exactly. It is
 *  also a running mean, so it is exactly conservative in the row, which means
 *  it cannot perturb the zonal mean the nudge just set.
 *
 *  Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainPolarFilterCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    const float Mu = SimRowToMu((float) C.y);

    const int Half = SimFilterHalfWidth(Mu, SimFilterLatitude, SimFilterMaxHalfWidth);

    if (Half <= 0)
    {
		// Untouched, but still written: this pass ping-pongs, so a row that
		// skips the filter must still be copied or it reverts to whatever the
		// destination held two steps ago.
        SimVorticityUAV[int3(C, Layer)] = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));
        return;
    }

    float Sum = 0.0f;

	[loop]
    for (int K = -Half; K <= Half; K++)
    {
        Sum += SimLoad(SimVorticitySRV, C + int2(K, 0), Layer);
    }

    SimVorticityUAV[int3(C, Layer)] = Sum / (float) (2 * Half + 1);
}

// ---------------------------------------------------------------------------
// Poisson solve
//
// WHY RED-BLACK SOR AND NOT SOMETHING BETTER.
//
// The textbook answers are multigrid, or a Fourier transform in longitude
// reducing the problem to one tridiagonal solve per zonal wavenumber. Both are
// better in the worst case and the Fourier one is exact in a single pass. Both
// are also a great deal of code.
//
// The case here is not the worst case. The field changes very little in one
// step, so the PREVIOUS step's psi is an excellent initial guess, and an
// iterative solver warm-started from a near-solution converges in a handful of
// sweeps rather than in the hundreds a cold start would need. The one cold
// start is at init, which is off the frame budget entirely and can simply run
// more sweeps.
//
// So the shape of the problem pays for the cheap solver. If that stops being
// true -- much higher resolution, or a much larger timestep -- the upgrade is
// the Fourier route, and it is a drop-in replacement for this pass alone.
//
// RED-BLACK, so each sweep is two dispatches of opposite parity. Every thread
// in a dispatch reads only texels of the other colour, which no thread in that
// dispatch writes, so the update is in-place with no ping-pong and no hazard.
// Gauss-Seidel ordering also converges roughly twice as fast as Jacobi, and
// over-relaxation on top of it is another large factor.
// ---------------------------------------------------------------------------

/** Over-relaxation factor. 1 is plain Gauss-Seidel. The optimum for a Poisson
 *  problem of this size is somewhere near 1.8, and above 2 the iteration
 *  diverges -- not slowly, immediately. */
float SimRelaxation;

/** 0 updates texels where (i+j) is even, 1 where it is odd. */
int SimRedBlackParity;

/** Dispatch (N_lon, N_lat, LayerCount). */
[numthreads(8, 8, 1)]
void MainPoissonCS(uint3 Id : SV_DispatchThreadID)
{
    if (SimOutOfBounds(Id))
    {
        return;
    }

    const int2 C = int2(Id.xy);
    const uint Layer = Id.z;

    if ((((C.x + C.y) & 1) != SimRedBlackParity))
    {
        return;
    }

	// Read back through the UAV rather than through a second view of the same
	// resource. Legal here precisely because of the red-black ordering: every
	// tap below is the opposite colour to this texel, so no thread in this
	// dispatch is writing any of them.
    const int2 W = SimWrapCoord(C + int2(-1, 0));
    const int2 E = SimWrapCoord(C + int2(1, 0));
    const int2 S = SimWrapCoord(C + int2(0, -1));
    const int2 N = SimWrapCoord(C + int2(0, 1));

    const float Centre = SimPsiUAV[int3(C, Layer)];

    float Diagonal;
    const float Applied = SimLaplacianFromTaps(
		C.y,
		Centre,
		SimPsiUAV[int3(W, Layer)],
		SimPsiUAV[int3(E, Layer)],
		SimPsiUAV[int3(S, Layer)],
		SimPsiUAV[int3(N, Layer)],
		Diagonal);

    const float Source = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));

	// Residual correction. Diagonal is strictly negative, so no guard is needed
	// and none is written; a guard here would mask a grid or coefficient error
	// rather than fix one.
    SimPsiUAV[int3(C, Layer)] = Centre + SimRelaxation * (Source - Applied) / Diagonal;
}

// ---------------------------------------------------------------------------
// Debug visualisation
//
// WHY THIS EXISTS BEFORE THE MATERIAL DOES.
//
// Every field in this sim is a signed scalar on a grid, and every failure mode
// is a shape in one of them: a nudge fighting the drag shows up as banded
// residual, a wrong Laplacian coefficient shows up as a ring at fixed latitude,
// an under-converged solve shows up as residual that never goes grey, a polar
// filter that is too aggressive shows up as a visibly smeared cap.
//
// None of that is diagnosable through the finished material, where the field
// has been warped, composited, turned into cloud-top altitude and raymarched.
// By the time it is a planet, "the bands look wrong" has a dozen candidate
// causes spanning two thousand lines. Looking at omega directly has one.
//
// So this writes a flat 2D picture of one selected field, at grid resolution,
// with no interpolation -- point sampled deliberately, so what is on screen is
// texels rather than a smoothed impression of them. Aliasing IS the signal
// here; a checkerboard in the residual is a red-black solver bug and a filtered
// view would hide it.
// ---------------------------------------------------------------------------

RWTexture2D<float4> SimDebugUAV;

/** See GG_DEBUG_* below. */
int SimDebugMode;

/** Which layer of the stack to show. */
int SimDebugLayer;

/** Value mapped to full saturation. Everything is signed and O(JetStrength),
 *  so this usually wants to be a small multiple of it. */
float SimDebugScale;

int2 SimDebugSize;

#define GG_DEBUG_VORTICITY   0
#define GG_DEBUG_PSI         1
#define GG_DEBUG_SPEED       2
#define GG_DEBUG_EAST        3
#define GG_DEBUG_NORTH       4
#define GG_DEBUG_RESIDUAL    5
#define GG_DEBUG_ZONAL_ERROR 6

/** Diverging ramp. Blue negative, near-black zero, red positive.
 *
 *  Diverging rather than a heat ramp because every quantity here is SIGNED and
 *  the sign is the information -- cyclonic against anticyclonic, prograde
 *  against retrograde. A heat ramp puts zero at one end and makes the two
 *  circulation senses look like different magnitudes of the same thing.
 *
 *  Deliberately dark at zero, so that a field which has collapsed to nothing
 *  reads as an obviously empty frame rather than as a uniform mid-grey that
 *  could be mistaken for a working sim at low contrast. */
float3 SimSignedRamp(float V)
{
    const float T = clamp(V, -1.0f, 1.0f);

    const float3 Negative = float3(0.15f, 0.35f, 1.0f);
    const float3 Positive = float3(1.0f, 0.30f, 0.12f);

    return (T < 0.0f) ? Negative * (-T) : Positive * T;
}

/** Dispatch (DebugWidth, DebugHeight, 1). */
[numthreads(8, 8, 1)]
void MainDebugVisCS(uint3 Id : SV_DispatchThreadID)
{
    if (any(int2(Id.xy) >= SimDebugSize))
    {
        return;
    }

    const uint Layer = (uint) clamp(SimDebugLayer, 0, SimGridSize.z - 1);

	// Nearest-neighbour into the grid. If the debug target is sized to the grid
	// this is exactly 1:1, which is the intended setup.
    const int2 C = int2(
		(int) ((float) Id.x / (float) SimDebugSize.x * SimGridSize.x),
		(int) ((float) Id.y / (float) SimDebugSize.y * SimGridSize.y));

    const float Mu = SimRowToMu((float) C.y);

    float Value = 0.0f;

    if (SimDebugMode == GG_DEBUG_VORTICITY)
    {
        Value = SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));
    }
    else if (SimDebugMode == GG_DEBUG_PSI)
    {
        Value = SimPsiSRV.Load(int4(C.x, C.y, Layer, 0));
    }
    else if (SimDebugMode == GG_DEBUG_SPEED)
    {
		// Unsigned, so it is shown on the positive half of the ramp only.
        Value = length(SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).xyz);
    }
    else if (SimDebugMode == GG_DEBUG_EAST)
    {
        const float3 V = SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).xyz;
        Value = dot(V, SimEast(SimColumnToLon((float) C.x)));
    }
    else if (SimDebugMode == GG_DEBUG_NORTH)
    {
        const float3 V = SimVelocitySRV.Load(int4(C.x, C.y, Layer, 0)).xyz;
        Value = dot(V, SimNorth(SimColumnToLon((float) C.x), Mu));
    }
    else if (SimDebugMode == GG_DEBUG_RESIDUAL)
    {
		// THE CONVERGENCE DIAGNOSTIC. Laplacian(psi) - omega should be
		// featureless. Structure here means the solve has not converged, and
		// WHERE the structure is says why: concentrated at high latitude means
		// the operator is too stiff and the filter is not doing enough, spread
		// evenly means too few iterations, and a checkerboard means the
		// red-black parity is wrong.
        float Diagonal;
        const float Applied = SimLaplacian(SimPsiSRV, C, Layer, Diagonal);

        Value = Applied - SimVorticitySRV.Load(int4(C.x, C.y, Layer, 0));
    }
    else if (SimDebugMode == GG_DEBUG_ZONAL_ERROR)
    {
		// Is the nudge winning? This should sit near zero once spun up. A
		// persistent offset means NudgeRate is losing to DragRate, and a
		// pattern that alternates with the bands means the two are fighting at
		// the jet cores specifically -- which is the signature of the clamped
		// slope being wrong, so check GG_JetScaledSlope first.
        float BandCount, JetStrength, Boost, Asymmetry;
        SimLayerJets(Layer, BandCount, JetStrength, Boost, Asymmetry);

        const float Target = GG_ZonalVorticity(Mu, BandCount, JetStrength, Boost, Asymmetry, SimBandShape.xyz);

        Value = SimRowMeanSRV.Load(int3(C.y, Layer, 0)) - Target;
    }

    const float3 Colour = SimSignedRamp(Value / max(SimDebugScale, 1e-6f));

    SimDebugUAV[int2(Id.xy)] = float4(Colour, 1.0f);
}
