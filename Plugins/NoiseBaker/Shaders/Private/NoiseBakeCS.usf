// Bake entry point. One thread per voxel, dispatched over a Z slab of the
// volume; results land in a flat structured buffer sized to the slab, which the
// CPU reads back and quantizes.
//
// Writing to a buffer rather than an RWTexture3D is deliberate. Readback of a
// volume texture is awkward across RHIs, and the slab-sized buffer also caps
// VRAM: a full 512^3 float4 target is 512MB resident, whereas a 32-slice slab
// is 32MB regardless of volume resolution.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/NoiseBaker/Private/PeriodicNoise.ush"

int3 VolumeResolution;
int SliceOffset;
int SliceCount;
int Supersample;
/** Which stages of the shaping chain to run. The two probe passes need
 *  different amounts of it, and a boolean could not express three cases.
 *
 *    0 Raw          Straight FBM output. The range probe measures this.
 *    1 Normalized   Normalization only, in [0,1]. The distribution probe
 *                   measures this, because redistribution operates on the
 *                   normalized value and a histogram of raw values would have
 *                   to be re-binned afterwards, losing precision exactly where
 *                   the median sits.
 *    2 Full         Everything: normalize, redistribute, remap, invert,
 *                   polarity, storage encode.
 */
int ShapeStage;

/** NVB_EVAL_*. Selects what a voxel actually evaluates. */
int EvalMode;

/** Central-difference step for curl, in UVW units. */
float CurlEpsilon;

/** Constant offset added to UVW before evaluation. Zero for a normal bake.
 *  The tiling self-test dispatches with this set to one unit along an axis and
 *  compares against the zero-offset result; because the field is periodic with
 *  period exactly 1.0 in UVW, the two must agree. */
float3 DomainOffset;

// Gain, WorleyJitter, WorleySmoothness, unused
float4 ChannelParamsA[4];

// Basis, BasePeriod, Octaves, Lacunarity
int4 ChannelParamsB[4];

// Seed, Flags, DistributionMode, unused
int4 ChannelParamsC[4];

// NormalizeScale, NormalizeBias, EncodeScale, EncodeBias
float4 ChannelNorm[4];

// DistributionGamma, PolarityScale, PolarityBias, unused
float4 ChannelShaping[4];

/** Per-channel equalization CDF, 64 scalar samples each, packed four to a
 *  float4. Channel c occupies entries [c*16, c*16+16). */
float4 ChannelEqLut[64];

RWStructuredBuffer<float4> OutVolume;

/** Raw FBM for one channel, before normalization and shaping. */
float EvalChannelRaw(int ChannelIndex, float3 UVW)
{
    const float4 A = ChannelParamsA[ChannelIndex];
    const int4 B = ChannelParamsB[ChannelIndex];
    const int4 C = ChannelParamsC[ChannelIndex];

    const bool bRidged = (C.y & PN_FLAG_RIDGED) != 0;

    return PN_FBM(
		/* Basis      */ B.x,
		/* UVW        */ UVW,
		/* BasePeriod */ B.y,
		/* Octaves    */ B.z,
		/* Lacunarity */ B.w,
		/* Gain       */ A.x,
		/* Seed       */ (uint) C.x,
		/* Jitter     */ A.y,
		/* Smoothness */ A.z,
		/* bRidged    */ bRidged);
}

#define NVB_STAGE_RAW			0
#define NVB_STAGE_NORMALIZED	1
#define NVB_STAGE_FULL			2

#define NVB_DIST_NONE			0
#define NVB_DIST_CENTER_MEDIAN	1
#define NVB_DIST_EQUALIZE		2

/** Reads sample index i of channel c from the packed equalization LUT. */
float SampleEqLutRaw(int ChannelIndex, int SampleIndex)
{
    const float4 Packed = ChannelEqLut[ChannelIndex * 16 + (SampleIndex >> 2)];
    const int Component = SampleIndex & 3;

    return (Component == 0) ? Packed.x
		 : (Component == 1) ? Packed.y
		 : (Component == 2) ? Packed.z
		 : Packed.w;
}

/** Linearly interpolated CDF lookup. The CDF is monotone and smooth, so 64
 *  samples with a lerp between them is well past sufficient, and staying
 *  monotone is what guarantees level sets survive. */
float SampleEqLut(int ChannelIndex, float V)
{
    const float Position = saturate(V) * 63.0f;
    const int Lower = (int) floor(Position);
    const int Upper = min(Lower + 1, 63);
    const float Fraction = Position - (float) Lower;

    return lerp(SampleEqLutRaw(ChannelIndex, Lower), SampleEqLutRaw(ChannelIndex, Upper), Fraction);
}

/** Value redistribution. Monotone in every mode, so features never move. */
float ApplyDistribution(int ChannelIndex, float V)
{
    const int Mode = ChannelParamsC[ChannelIndex].z;

    if (Mode == NVB_DIST_CENTER_MEDIAN)
    {
		// v^g with g = ln(0.5)/ln(median), so the median lands on 0.5 while the
		// endpoints stay pinned at 0 and 1.
        return pow(max(V, 1e-6f), ChannelShaping[ChannelIndex].x);
    }

    if (Mode == NVB_DIST_EQUALIZE)
    {
        return SampleEqLut(ChannelIndex, V);
    }

    return V;
}

/** The shaping chain, in order:
 *
 *    normalize    raw FBM -> [0,1], a fixed domain for everything downstream
 *    redistribute [0,1] -> [0,1], monotone, so no feature moves
 *    polarity     -> [-1,1] via v * 2 - 1, or identity
 *    encode       fit a signed value into an unsigned storage format
 *
 *  There is deliberately no output range remap and no inversion here. Both are
 *  post-sum scalar maps on the finished value, so a consumer reproduces either
 *  with a single multiply-add at the sample site. Baking a narrowed range would
 *  additionally be lossy: [0, 0.5] on BGRA8 spends 128 of 256 levels on
 *  something a multiply does for free.
 *
 *  Redistribution stays despite also acting on the finished value, because
 *  Equalize needs the CDF of the whole volume and a consumer sampling one texel
 *  does not have it. */
float ShapeChannel(int ChannelIndex, float Raw)
{
    const float4 N = ChannelNorm[ChannelIndex];
    const float4 S = ChannelShaping[ChannelIndex];

    float V = saturate(Raw * N.x + N.y);

    if (ShapeStage == NVB_STAGE_NORMALIZED)
    {
        return V;
    }

    V = ApplyDistribution(ChannelIndex, V);

    V = V * S.y + S.z;

    return V * N.z + N.w;
}

#define NVB_EVAL_PACKED				0
#define NVB_EVAL_CURL				1
#define NVB_EVAL_GRADIENT			2

#define NVB_VEC_ALPHA_INDEPENDENT	0
#define NVB_VEC_ALPHA_MAGNITUDE		1
#define NVB_VEC_ALPHA_POTENTIAL		2

/** Gradient of a scalar potential, by central differences.
 *
 *  f is channel recipe 0. The result is CURL-FREE: pure sources and sinks,
 *  pointing uphill toward maxima. The exact complement of EvalCurl below, and
 *  the two are the pure cases of the Helmholtz decomposition.
 *
 *  Six evaluations, against curl's twelve, and one noise instance rather than
 *  three.
 *
 *  Baked as +grad f, the mathematical definition. A consumer that wants
 *  attraction toward high values negates at the sample site, which is free. */
float3 EvalGradient(float3 UVW)
{
    const float E = CurlEpsilon;

    const float3 DX = float3(E, 0.0f, 0.0f);
    const float3 DY = float3(0.0f, E, 0.0f);
    const float3 DZ = float3(0.0f, 0.0f, E);

    const float Fxp = EvalChannelRaw(0, UVW + DX);
    const float Fxn = EvalChannelRaw(0, UVW - DX);
    const float Fyp = EvalChannelRaw(0, UVW + DY);
    const float Fyn = EvalChannelRaw(0, UVW - DY);
    const float Fzp = EvalChannelRaw(0, UVW + DZ);
    const float Fzn = EvalChannelRaw(0, UVW - DZ);

    const float InvTwoE = 1.0f / (2.0f * max(E, 1e-8f));

    return float3(Fxp - Fxn, Fyp - Fyn, Fzp - Fzn) * InvTwoE;
}

/** Curl of a vector potential, by central differences.
 *
 *  The potential's three components are channel recipes 0, 1 and 2, which the
 *  recipe fills with one authored potential at three decorrelating seeds.
 *
 *  That is what makes the result DIVERGENCE-FREE: all three output components
 *  are derivatives of a single potential field. Three independently authored
 *  scalar noises in RGB would have sources and sinks everywhere, which is
 *  precisely what curl noise exists to eliminate. Using ONE instance for all
 *  three components fails differently and just as badly: the cross terms
 *  collapse and the output is confined to a plane.
 *
 *  Only the twelve partials the cross product actually needs are evaluated, not
 *  the full potential at all six neighbours, which would be eighteen.
 *
 *  Tiling survives both this and the gradient: the potential is periodic with
 *  period 1 in UVW, and a finite difference of a periodic function is periodic
 *  with the same period. */
float3 EvalCurl(float3 UVW)
{
    const float E = CurlEpsilon;

    const float3 DX = float3(E, 0.0f, 0.0f);
    const float3 DY = float3(0.0f, E, 0.0f);
    const float3 DZ = float3(0.0f, 0.0f, E);

	// x = dPz/dy - dPy/dz
    const float Pz_yp = EvalChannelRaw(2, UVW + DY);
    const float Pz_yn = EvalChannelRaw(2, UVW - DY);
    const float Py_zp = EvalChannelRaw(1, UVW + DZ);
    const float Py_zn = EvalChannelRaw(1, UVW - DZ);

	// y = dPx/dz - dPz/dx
    const float Px_zp = EvalChannelRaw(0, UVW + DZ);
    const float Px_zn = EvalChannelRaw(0, UVW - DZ);
    const float Pz_xp = EvalChannelRaw(2, UVW + DX);
    const float Pz_xn = EvalChannelRaw(2, UVW - DX);

	// z = dPy/dx - dPx/dy
    const float Py_xp = EvalChannelRaw(1, UVW + DX);
    const float Py_xn = EvalChannelRaw(1, UVW - DX);
    const float Px_yp = EvalChannelRaw(0, UVW + DY);
    const float Px_yn = EvalChannelRaw(0, UVW - DY);

    const float InvTwoE = 1.0f / (2.0f * max(E, 1e-8f));

    return float3(
		((Pz_yp - Pz_yn) - (Py_zp - Py_zn)) * InvTwoE,
		((Px_zp - Px_zn) - (Pz_xp - Pz_xn)) * InvTwoE,
		((Py_xp - Py_xn) - (Px_yp - Px_yn)) * InvTwoE);
}

float4 EvalAllRaw(float3 UVW)
{
    if (EvalMode != NVB_EVAL_PACKED)
    {
        const float3 V = (EvalMode == NVB_EVAL_CURL) ? EvalCurl(UVW) : EvalGradient(UVW);

        const int AlphaMode = ChannelParamsC[3].w;

        float Alpha;
        if (AlphaMode == NVB_VEC_ALPHA_MAGNITUDE)
        {
            Alpha = length(V);
        }
        else if (AlphaMode == NVB_VEC_ALPHA_POTENTIAL)
        {
            Alpha = EvalChannelRaw(0, UVW);
        }
        else
        {
            Alpha = EvalChannelRaw(3, UVW);
        }

        return float4(V, Alpha);
    }

    return float4(
		EvalChannelRaw(0, UVW),
		EvalChannelRaw(1, UVW),
		EvalChannelRaw(2, UVW),
		EvalChannelRaw(3, UVW));
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, THREADGROUP_SIZE)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const int3 Local = (int3) DispatchThreadId;

    if (Local.x >= VolumeResolution.x ||
		Local.y >= VolumeResolution.y ||
		Local.z >= SliceCount)
    {
        return;
    }

    const int3 Voxel = int3(Local.xy, Local.z + SliceOffset);

    const int SS = max(Supersample, 1);
    const float InvSS = 1.0f / (float) SS;
    const float InvSampleCount = 1.0f / (float) (SS * SS * SS);

    float4 Accum = 0.0f;

	[loop]
    for (int sz = 0; sz < SS; ++sz)
    {
		[loop]
        for (int sy = 0; sy < SS; ++sy)
        {
			[loop]
            for (int sx = 0; sx < SS; ++sx)
            {
				// Voxel-centre convention. With SS == 1 this is exactly
				// (Voxel + 0.5) / Resolution, which places voxel 0 and voxel
				// N-1 half a voxel inside the tile on either side, so they are
				// neighbours under wrap addressing. Sampling at
				// Voxel / (Resolution - 1) instead duplicates the boundary row
				// and produces a visible seam under an otherwise correct
				// periodic function.
                const float3 SubSample = (float3(sx, sy, sz) + 0.5f) * InvSS;
                const float3 UVW = (float3(Voxel) + SubSample) / float3(VolumeResolution) + DomainOffset;

                Accum += EvalAllRaw(UVW);
            }
        }
    }

    Accum *= InvSampleCount;

    if (ShapeStage != NVB_STAGE_RAW)
    {
        Accum = float4(
			ShapeChannel(0, Accum.x),
			ShapeChannel(1, Accum.y),
			ShapeChannel(2, Accum.z),
			ShapeChannel(3, Accum.w));
    }

    const int Index = (Local.z * VolumeResolution.y + Local.y) * VolumeResolution.x + Local.x;
    OutVolume[Index] = Accum;
}
