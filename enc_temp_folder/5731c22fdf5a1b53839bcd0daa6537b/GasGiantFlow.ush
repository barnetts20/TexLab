#pragma once

#include "/Plugin/NoiseBaker/Private/GasGiantConstants.ush"


// ---------------------------------------------------------------------------
// Gas giant banding and flow. Three baked volumes, one Custom node.
//
// WHY GAS GIANTS BAND, since the whole design follows from it.
//
// Rapid rotation makes the flow quasi-2D. Two-dimensional turbulence cascades
// energy UPWARD in scale rather than downward, so structure grows instead of
// dissipating. On a sphere the Coriolis parameter varies with latitude, which
// makes that cascade anisotropic: it feeds east-west modes preferentially,
// because north-south motion radiates Rossby waves and east-west motion does
// not. The cascade arrests at the Rhines scale, into zonal jets.
//
// This file used to CONSTRUCT that: prescribed differential rotation applied to
// baked isotropic noise. That was a defensible model -- banding really is
// anisotropic straining of isotropic structure -- but a kinematic shear has no
// way to SUSTAIN anything, so every vortex was eventually drawn into a filament
// and the field had to be periodically reset behind a crossfade.
//
// The flow is now simulated. What this file does is turn a flow field into
// cloud, which is what it was always for.
//
// THE THREE OPERATIONS, deliberately separated.
//
//   Structure   Filaments and whorls. Comes from the simulated field, which
//               carries eddies that persist because they are fed.
//
//   Transport   Bands and their contents moving. The sim's velocity carries
//               the jets; the planet's own rotation is one GG_RotateZ.
//
//   Evolution   Things changing rather than merely moving. The sim again --
//               it is temporally coherent, so nothing here accumulates.
//
// WHY ROTATION AND NOT DISPLACEMENT, for the rigid spin.
//
// No offset added to a coordinate produces orbiting; it produces scrolling
// across an axis, and on a sphere it also drags latitude. Displacing along the
// east vector by c and renormalizing moves along a CHORD, so the length becomes
// sqrt(1 + c*c) and the latitude creeps equatorward as c grows.
//
// Rotation about Z preserves P.z and |P| identically. Every latitude ring maps
// onto itself, the Jacobian determinant is exactly 1, and there is no
// accumulation error to reset. A latitude-only pattern is invariant under it,
// which is the precise statement that zonal flow cannot disturb its own bands
// -- so all band meander comes from the warp, and the warp now carries real
// eddies rather than constructed ones.
//
// THE INPUTS.
//
//   FlowField    Texture2DArray from the sim. RGB is tangent velocity as an
//                ANGULAR RATE in planet-local space; A is the streamfunction,
//                read as pressure. Velocity is N x grad(psi), so circulation
//                and pressure come from one field and vortex centres in alpha
//                are exactly what the velocity circles. Sampled by direction.
//                One slice per simulated layer, so a deeper slice can advect
//                the detail deck and produce real vertical wind shear.
//
//                SAMPLER: WRAP ON U, CLAMP ON V. The grid is a cylinder.
//
//   DetailFlow   Gradient + INDEPENDENT alpha, RGBA16F. A is best spent on
//                Worley F2-F1, whose cell walls give the filament network
//                directly. The C0 warning on F2-F1 does not apply because this
//                channel is read, never differentiated.
//
//   PackedDetail Four independent scalars, BGRA8. Chemistry riding on top of
//                the flow rather than part of it, so it is held nearly rigid.
//
// THE TWO 3D VOLUMES ARE WRAP ON ALL THREE AXES.
//
/** Steps in the warp integration.
 *
 *  Each step takes 1/N of the displacement and re-samples where it arrived, so
 *  the path follows the field rather than leaving along a single tangent. What
 *  that buys is the streamline's CURVATURE -- one step moves material once and
 *  stops, so the shape of the streamline never appears in the output no matter
 *  what the field holds.
 *
 *  Costs one fetch per step. Cheaper than it was: there is one phase now rather
 *  than two, so 4 here costs what 2 used to. */
#ifndef GG_WARP_ITERATIONS
#define GG_WARP_ITERATIONS 4
#endif

/** Replace the returned cloud top with the step count, normalized against
 *  InMaxSteps, for a cost heatmap. */
#ifndef GG_DEBUG_STEPS
#define GG_DEBUG_STEPS 0
#endif

/** Enable the second warp octave and its ridge channel. Two extra fetches: the
 *  baked detail volume, and the deeper simulated layer that advects it. The
 *  first thing to switch off if the march gets expensive. */
#ifndef GG_DETAIL_OCTAVE
#define GG_DETAIL_OCTAVE 1
#endif

/** Include the packed detail layer. One extra fetch. */
#ifndef GG_PACKED_DETAIL
#define GG_PACKED_DETAIL 1
#endif

/** Rotation about the planet's axis. The only transport primitive used here.
 *
 *  Exact for any angle, so it never needs to be small and never needs a reset.
 *  Preserves P.z, which is what leaves the bands undisturbed. */
float3 GG_RotateZ(float3 P, float Angle)
{
    float SinA, CosA;
    sincos(Angle, SinA, CosA);

    return float3(
		P.x * CosA - P.y * SinA,
		P.x * SinA + P.y * CosA,
		P.z);
}

/** Perlin dilated by inverted Worley -- the standard cloud-shape combine.
 *
 *  Perlin alone is smooth undulation with no sense of a cloud EDGE. Worley F1
 *  inverted is billowy blobs with no interior variation. Remapping the first by
 *  the second keeps Perlin's detail while giving it Worley's rounded boundary,
 *  and that rounded boundary is what reads as fluffiness.
 *
 *  This has to happen in the shader rather than the bake because the baker's
 *  channels are independent by construction -- there is no cross-channel
 *  operation in the recipe model, and adding one would compromise the thing
 *  that makes the probe, grouping and brick bounds work. Two channels out, one
 *  combine in, no fetch cost.
 *
 *  Worley here is the raw F1, which is LOW at cell centres, so the remap floor
 *  uses it directly rather than inverted. */
float GG_PerlinWorley(float Perlin, float WorleyF1)
{
    const float Low = -WorleyF1;

    return saturate((Perlin - Low) / max(1.0f - Low, 1e-3f));
}

// ---------------------------------------------------------------------------
// The field
//
// WHAT CHANGED, AND WHY MOST OF THIS FILE GOT SHORTER.
//
// The flow used to be constructed here: a prescribed differential rotation
// applied to baked isotropic noise, integrated over a warp, with the whole
// crossfade apparatus wrapped around it to bound winding that would otherwise
// run away. That model was defensible -- banding really is anisotropic
// straining of isotropic structure -- but it had no mechanism to SUSTAIN
// anything. Shear only ever stretches, so every vortex was eventually drawn
// into a filament, which is why spots had to be exempted from the shear by
// hand and why the field needed periodic resetting at all.
//
// The flow now comes from a simulation. Velocity arrives as a texture, already
// carrying jets, eddies and vortices that persist because they are fed rather
// than because they were excluded. So the constructing goes away and what is
// left here is what this file was always for: turning a flow field into cloud.
//
// DELETED, all of it existing only to manage unbounded kinematic shear:
// the crossfade, SpinUpTime, CrossfadePeriod, PhaseJitterAmount, ShearFalloff,
// Swirl, the two-phase evaluation, and the cat's-eye construction that made
// closed streamlines by choosing a co-moving frame. The sim has closed
// streamlines because the fluid does.
//
// WHAT THE WARP IS FOR NOW, WHICH IS NOT WHAT IT WAS FOR.
//
// It used to integrate the whole history of the flow, and its length was how
// wound the planet was. It is now a SHORT advection -- a fraction of an eddy
// turnover -- whose only job is to carry the fine detail volumes along the
// current flow. The history lives in the sim, which is temporally coherent and
// regenerates structure continuously, so nothing here has to accumulate.
//
// That is what makes it bounded by construction rather than by a crossfade,
// and it is the whole reason the sim was worth building.
// ---------------------------------------------------------------------------

/** Samples the simulated flow field by DIRECTION.
 *
 *  The sim grid is longitude by sin(latitude), which makes both coordinates
 *  cheap from a unit vector:
 *
 *      U = frac(atan2(N.y, N.x) / 2pi)      one transcendental
 *      V = 0.5 + 0.5 * N.z                  free, because the grid is in sin
 *
 *  frac() rather than a branch on the sign: atan2 returns (-pi, pi], and frac
 *  of a negative value already wraps to the positive end, so the seam is
 *  handled by the same instruction that does the scaling.
 *
 *  SAMPLER STATE MUST BE WRAP ON U AND CLAMP ON V. The grid is a cylinder, not
 *  a torus: longitude wraps, latitude does not, and a wrapping V joins the
 *  north pole to the south.
 *
 *  Returns float4(u_east, u_north, psi_eddy, band):
 *
 *    xy  Tangent velocity components, in radians per unit time. Rebuild the 3D
 *        vector with GG_FlowVelocity. Stored as two components because a
 *        tangent vector has two degrees of freedom, and the third channel is
 *        worth more elsewhere.
 *
 *    z   The EDDY streamfunction: psi with its zonal mean removed. Zero in
 *        undisturbed flow, positive in anticyclones, negative in cyclones.
 *        Raw psi would be dominated by its latitude ramp, so every use of it
 *        would land on bands rather than on storms.
 *
 *    w   Normalized vorticity, near [-1,1]. THIS IS THE BAND SIGNAL. Bands are
 *        what vorticity looks like, and because the sim transports vorticity,
 *        this arrives already meandering and already wrapped around vortices --
 *        no warping in the material is needed to produce that.
 *
 *  Units are physical throughout and normalization is done sim-side, so there
 *  is no calibration constant here and nothing to keep in sync by hand. */
float4 GG_SampleFlow(Texture2DArray FlowField, SamplerState FlowSampler, float3 N, float Layer)
{
    const float U = frac(atan2(N.y, N.x) * (0.5f / PI));
    const float V = 0.5f + 0.5f * N.z;

    return FlowField.SampleLevel(FlowSampler, float3(U, V, Layer), 0.0f);
}

/** Rebuilds the 3D tangent velocity from the stored components.
 *
 *  NO TRIG. With c = length(N.xy) the tangent basis is
 *
 *      east  = (-N.y, N.x, 0) / c
 *      north = (-N.z*N.x/c, -N.z*N.y/c, c)
 *
 *  which are the same vectors sincos(longitude) would give, obtained from N
 *  directly. That is what makes storing two components cheaper than storing
 *  three: about ten ALU against a whole texture channel.
 *
 *  Guarded at the poles, where c goes to zero and east is undefined. The sim
 *  grid is cell-centred so no sampled texel sits exactly on a pole, but a
 *  shading point can. */
float3 GG_FlowVelocity(float3 N, float4 Flow)
{
    const float C = max(length(N.xy), 1e-5f);

    const float3 East = float3(-N.y, N.x, 0.0f) / C;
    const float3 North = float3(-N.z * N.x / C, -N.z * N.y / C, C);

    return East * Flow.x + North * Flow.y;
}

/** Cloud top altitude, as a fraction of the shell thickness.
 *
 *  THE DECK, AND NOTHING BUT THE DECK. Built entirely from the simulated flow:
 *  band elevation, pressure lift, storm towers. No detail noise appears here.
 *
 *  It used to. The detail was summed into the elevation and the whole thing
 *  multiplied by BandRelief, which coupled two unrelated knobs -- and worse,
 *  turned a 3D noise field into a displacement of a 2D surface. A volume
 *  sampled at a unit direction is a spherical SLICE through it: all the
 *  vertical structure that was baked in gets discarded, and a bespoke radial
 *  displacement is invented to replace it. That is strictly worse than the
 *  structure already in the volume, and it is what made the detail read as
 *  spikes.
 *
 *  The detail now modulates DENSITY inside the deck instead, sampled at the
 *  true 3D position. See GG_Density.
 *
 *  Relief is float4(TopBase, BandRelief, PressureLift, StormTowers).
 *
 *  ReliefScale collapses the band relief toward flat where the flow is
 *  straining hard, and deliberately does NOT touch the pressure lift or the
 *  storm towers: those are vertical motion, not stretched material, so thinning
 *  them would flatten storms precisely where the flow is most active.
 *
 *  The pressure sign is not arbitrary. Anticyclones are high pressure, rising,
 *  and condense fresh ammonia above the haze -- they are the bright ovals and
 *  the Great Red Spot, and they must sit HIGH. Cyclones sink and expose deeper
 *  material, so they must sit low. Getting this backwards produces a field that
 *  reads as plausible until you notice every storm is a pit. */
float GG_CloudTop(
	float Elevation,
	float Pressure,
	float StormCells,
	float ReliefScale,
	float4 Relief,
	float VortexThreshold)
{
	// Elevation runs 0 at a band boundary to 1 in a band interior, so Relief.y
	// is the whole height between a jet and a zone. It wants to be large: the
	// point of driving height from the flow is that the bands are geometry
	// rather than a pattern painted on a sphere.
    float Top = Relief.x + ReliefScale * Relief.y * (Elevation - 0.5f);

    Top += Relief.z * Pressure;

	// Convective towers, only where the circulation supports one. Ungated,
	// Worley F1 is polka dots; gated on vortex strength it becomes storms that
	// sit where the flow says they should. Inverted because F1 is minimal at
	// cell CENTRES, which is where the tower belongs.
    const float Vortex = smoothstep(VortexThreshold, 1.0f, abs(Pressure));

    Top += Relief.w * (1.0f - StormCells) * Vortex;

    return Top;
}


/** Evaluates the cloud field at a direction on the sphere.
 *
 *  Returns:
 *    x  Cloud top altitude, as a fraction of the shell thickness. Flow only.
 *    y  Pressure. Negative is a low, so cyclonic; extrema are vortex centres
 *       and the circulation already matches them.
 *    z  BAND, signed and unclamped. Negative is one band type, positive the
 *       other, zero the boundary between them. Feed to GG_BandColour.
 *    w  SHAPE in [0,1], sampled in true 3D at Height. 1 is solid, 0 is clear.
 *       The density function multiplies by it; it never moves the deck.
 *
 *  Scales  float4(DetailScale, PackedScale, DetailWarpInherit, PackedWarpInherit)
 *  Warps   float4(WarpTime, DetailWarp, BandJitter, TurbulenceFloor)
 *  Detail  float4(Ridge, Mottle, Wisp, EdgeBias)
 *  Layers  float3(FlowLayer, DetailFlowLayer, unused)
 *
 *  Three fetches per evaluation, against eight before. */
float4 GG_Field(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailFlow,
	SamplerState DetailSampler,
	Texture3D PackedDetail,
	SamplerState PackedSampler,
	float3 P,
	float Time,
	float RigidRate,
	float4 Scales,
	float4 Warps,
	float4 Detail,
	float3 Layers,
	float Height,
	float BandSharpness,
	float ReliefThinning,
	float DetailVertical,
	float4 Relief,
	float VortexThreshold)
{
	// The planet's own rotation, and the only rigid term left. The sim runs in
	// the rotating frame, so its velocities are relative to this; the warp
	// window is far too short to accumulate a rotation, and a latitude-only
	// pattern is invariant under one anyway, so this has to be applied to the
	// SAMPLING POSITION rather than left to the flow.
    const float3 PSpun = GG_RotateZ(P, -RigidRate * Time);
    const float3 N = normalize(PSpun);
    const float S = N.z;

	// -- The band, straight from the flow ------------------------------------
	//
	// One sample, before the warp, used for three things: the band itself, the
	// pressure, and the turbulence weight that scales the warp. Sampling here
	// rather than inside the loop costs nothing -- the loop's first iteration
	// sampled this same position anyway -- and it breaks what would otherwise
	// be circular, since the warp length depends on the band.
	//
	// UNWARPED, deliberately. The sim transports vorticity, so the band pattern
	// arrives already advected: meandering, wrapped around vortices, carrying
	// the whole history of the flow. Warping the lookup on top of that would be
	// double-counting a transport that has already happened.
    const float4 Flow0 = GG_SampleFlow(FlowField, FlowSampler, N, Layers.x);

    const float Pressure = Flow0.z;

	// SIGN AND MAGNITUDE ARE TWO DIFFERENT THINGS AND DRIVE TWO DIFFERENT
	// OUTPUTS.
	//
	// The debug view renders vorticity as a diverging ramp: which colour is the
	// SIGN, and how bright is the MAGNITUDE. Those read as one image but they
	// are not one quantity, and collapsing them into a single bipolar channel
	// is what made the material's output stop resembling the debug view.
	//
	// Contrast applied once, here, before the split, so both halves stay
	// consistent with each other. Warps.z biases the balance first, which
	// shifts which band type dominates without retuning the sim.
    const float Zeta = (Flow0.w + Warps.z) * BandSharpness;

	// WHICH BAND, and by how much. SIGNED AND UNCLAMPED.
	//
	// Carried out raw rather than remapped into [0,1], because the colour ramp
	// wants both halves of it and a saturate here would throw away the range
	// before the ramp ever sees it -- a scale applied downstream would then be
	// re-expanding a value that had already lost its ends.
	//
	// This is exactly the quantity the debug view feeds its diverging ramp, so
	// GG_BandColour with a black edge colour reproduces that view precisely.
    const float BandSigned = Zeta;

	// HOW STRONG: the elevation. Zero at a band boundary, one at a band core --
	// so boundaries sit LOW and band interiors pile UP, which is the brightness
	// of the debug view read as height.
	//
	// That is also the right way round physically. Band boundaries are the
	// jets, where the shear is; band interiors are quiescent. Material gets
	// thinned where it is strained and accumulates where it is not.
    const float Elevation = saturate(abs(Zeta));

	// The boundary weight falls straight out of the elevation: a boundary is
	// exactly where the elevation is lowest. One subtract, and it cannot drift
	// out of step with the band the way a separately-derived weight could.
    const float Boundary = 1.0f - Elevation;

	// Turbulence follows the shear, and the shear lives at the boundaries. Zone
	// interiors go nearly laminar, which stops the bands reading as one
	// scalloped curve repeated all the way round. Warps.w is the floor, since a
	// real zone interior is calmer than its edges but not glass.
    const float Turbulence = lerp(Warps.w, 1.0f, Boundary);

    const float StepTime = (Warps.x * Turbulence) / (float) GG_WARP_ITERATIONS;

    float3 Pos = N;

	// Kept so the strain can be measured from the flow itself rather than from
	// an analytic profile. See the relief thinning note below.
    float3 FirstVelocity = 0.0f;
    float3 LastVelocity = 0.0f;

	[unroll]
    for (int It = 0; It < GG_WARP_ITERATIONS; It++)
    {
		// Reuses the pre-loop sample on the first iteration, so the extra
		// fetch above is genuinely free.
        const float4 Flow = (It == 0) ? Flow0
			: GG_SampleFlow(FlowField, FlowSampler, Pos, Layers.x);

        const float3 Velocity = GG_FlowVelocity(Pos, Flow);

        if (It == 0)
        {
            FirstVelocity = Velocity;
        }

        LastVelocity = Velocity;

		// Already tangent, already an angular rate, already containing both the
		// jets and the eddies. The old form needed a tangential projection, a
		// cross product, a separate analytic zonal term and a unit conversion;
		// all four are now properties of the field rather than steps here.
		//
		// Renormalized every step because the displacement leaves the sphere.
		// Only .z is read downstream, so a chord move would bias latitude, and
		// over several steps it compounds.
        Pos = normalize(Pos + Velocity * StepTime);
    }

    const float3 Warped = Pos;

	// Net displacement as a difference rather than a running sum: each step
	// renormalizes, so the sum of the steps is not the distance travelled.
    const float3 FlowWarp = Warped - N;

    float Ridge = 0.5f;
    float3 DetailWarp = 0.0f;

#if GG_DETAIL_OCTAVE

	// -- Detail: baked, warped by a DEEPER simulated layer -------------------
	//
	// Layers.y selects which slice of the stack drives this. Reading a
	// different layer from the coarse warp is what produces genuine vertical
	// wind shear: the two decks are advected by flows that disagree, because
	// the sim maintains them under different jet profiles.
	//
	// Inherits only a FRACTION of the coarse displacement. A displacement field
	// with a large gradient IS strain, whatever it is called, so inheriting one
	// whole imposes an order-one strain on the fine layer regardless of its own
	// flow. Physically the fraction is right too: a small eddy is regenerated
	// before it accumulates much strain, so it should be advected by a recent
	// slice of the flow's history rather than all of it.

    float3 PDetail = normalize(N + FlowWarp * Scales.z);

    const float4 DeepFlow = GG_SampleFlow(FlowField, FlowSampler, PDetail, Layers.y);

	// SAMPLED IN TRUE 3D, at the shading point's own altitude.
	//
	// PDetail is a unit direction, so PDetail * Scale traces a sphere through
	// the volume -- a 2D slice, throwing away every bit of vertical structure
	// the bake put there. Adding the altitude term walks radially through the
	// noise as the march climbs, so the volume is read as the volume it is.
	//
	// DetailVertical is how many noise units the shell thickness spans. It sets
	// the vertical feature size against Scales.x's horizontal one, so their
	// ratio is the aspect of the resulting structure -- which is the honest
	// version of the aspect-ratio control that a radial DISPLACEMENT of a 2D
	// slice was only ever faking.
	//
	// NO INDEPENDENT DRIFT. The volume moves because the flow moves it. It used
	// to scroll through its own domain on a clock, which made the detail change
	// whether or not anything was happening to it -- grain by definition. If it
	// looks pinned while the bands move over it, raise Warps.x rather than
	// reintroducing a clock.
    const float3 DetailUVW = PDetail * (Scales.x + Height * DetailVertical);
    const float4 DetailSample = DetailFlow.SampleLevel(DetailSampler, DetailUVW, 0.0f);

    DetailWarp = GG_FlowVelocity(PDetail, DeepFlow) * (Warps.y * Turbulence);
    Pos = normalize(Warped + DetailWarp);

	// The independent alpha. Worley F2-F1 is MINIMAL on cell walls, so the
	// filament network arrives dark and Ridge usually wants to be negative to
	// make it read as bright wisps.
    Ridge = DetailSample.a;
#endif

    const float3 FinalWarped = Pos;

    float4 Packed = 0.5f;

#if GG_PACKED_DETAIL

	// -- Packed: chemistry riding on top, held nearly rigid -------------------
	//
	// Its own inheritance, separate from the detail layer's, and 0 is a
	// legitimate setting rather than a degenerate one. This layer's job is to
	// break the flow up into rounded organic shapes, and a shape dragged
	// through the flow field is no longer round. The other layers want to
	// follow the flow because they ARE the flow; this one reads better held
	// rigid than stretched along with everything else.

    const float3 PPacked = normalize(N + (FlowWarp + DetailWarp) * Scales.w);

    const float3 PackedUVW = PPacked * (Scales.y + Height * DetailVertical);
    Packed = PackedDetail.SampleLevel(PackedSampler, PackedUVW, 0.0f);
#endif


	// RELIEF THINNING, MEASURED FROM THE FLOW RATHER THAN PRESCRIBED.
	//
	// Shear stretches a parcel horizontally without adding material to it, so
	// an incompressible parcel stretched by g in one direction and unchanged in
	// the other must thin VERTICALLY by 1/g. Heavily strained regions belong
	// lower and flatter, and this is what the fluid would actually do rather
	// than a correction applied to make it behave.
	//
	// Without it, filament width shrinks with strain while filament height does
	// not, so the aspect ratio runs away and the march reads them as spikes --
	// fine at distance, sharp acute peaks up close.
	//
	// The strain now comes from the WARP PATH, not from the jet profile. The
	// velocity difference between the start and end of the path, divided by the
	// distance travelled, is a directional derivative of velocity along the
	// streamline -- which is a strain rate, in the right units, for free: both
	// samples were already taken by the loop above.
	//
	// That is a real improvement over the analytic form, not just a saving. The
	// old version derived strain from the prescribed zonal profile, so it knew
	// nothing about eddies and reported zero thinning inside a vortex that was
	// straining material hard. It also needed JetStrength and EquatorialBoost
	// threaded down here purely to compute it, which meant two parameters that
	// had to be kept in sync with the sim by hand and did nothing else.
	//
	// Multiplied by the warp time to make it dimensionless, and normalized by
	// the band frequency so the parameter stays O(1).
    const float Travelled = length(FlowWarp);

    const float StrainRate = length(LastVelocity - FirstVelocity) / max(Travelled, 1e-5f);

	// BandCount is gone from this file, so the normalization it used to carry
	// folds into ReliefThinning. That is the only thing it affected.
    const float Winding = StrainRate * Warps.x;

    const float ReliefScale = 1.0f / (1.0f + ReliefThinning * Winding);

	// EDGE WEIGHTING. Boundary peaks mid-transition and falls to zero in a
	// saturated zone or belt. Detail applied uniformly is by definition grain:
	// it has no relationship to the structure it sits on. Detail concentrated
	// on the transitions ravels the band EDGES, which is where a real gas
	// giant's billows live.
	//
	// EdgeBias is how much survives in the flat interiors -- zero everywhere
	// but the edges is its own kind of artificial.
    const float Edge = lerp(Detail.w, 1.0f, Boundary);

	// R against G as Perlin-Worley: the fluffy cloud-shape term. B stays raw as
	// streaks, which want to look wispy rather than rounded.
    const float Fluff = GG_PerlinWorley(Packed.r, Packed.g);

	// A WEIGHTED MIX IN [0,1], NOT A SIGNED MODULATION.
	//
	// Every channel here is already unipolar, and the density function
	// MULTIPLIES by this rather than adding it -- so it has to stay a
	// coverage-like quantity, where 1 is solid and 0 is clear.
	//
	// Normalized by the weight sum, so changing the balance between ridge,
	// fluff and wisp does not also change how much cloud there is. Without it
	// the three sliders all double as a density control, which makes them
	// impossible to tune against each other.
    const float WeightSum = max(Detail.x + Detail.y + Detail.z, 1e-4f);

    const float Mix = saturate(
		(Detail.x * Ridge + Detail.y * Fluff + Detail.z * Packed.b) / WeightSum);

	// 1 in band interiors, falling toward the mix at the transitions. So the
	// detail breaks up the edges and leaves the zone interiors coherent.
    const float Shape = lerp(1.0f, Mix, Edge);

	// Top is assembled HERE rather than in the density function, because the
	// storm cell mask is Packed.g and Packed only exists in this scope.
    const float Top = GG_CloudTop(
		Elevation, Pressure, Packed.g, ReliefScale, Relief, VortexThreshold);

    return float4(Top, Pressure, BandSigned, Shape);
}

/** The band colour ramp. A generalisation of the debug view's diverging ramp.
 *
 *  The debug view picks a colour by the SIGN of vorticity and scales it by the
 *  MAGNITUDE, so zero comes out black and the band cores come out saturated.
 *  That reads considerably better than a straight two-colour lerp, because the
 *  dark line between bands is doing real work: it separates the two families
 *  instead of blending them through a muddy midpoint.
 *
 *  Generalised only in that the dark end is a parameter rather than black. With
 *  EdgeColour black this is exactly SimSignedRamp from the sim's debug shader.
 *
 *  Scale is the debug view's DebugScale inverted -- larger means more contrast,
 *  more saturated band cores, and a narrower dark line between them.
 *
 *  Band comes in signed and unclamped, so this is where the range is decided.
 *  Clamping earlier would have thrown it away before the ramp could use it. */
float3 GG_BandColour(float Band, float3 ColourA, float3 ColourB, float3 EdgeColour, float Scale)
{
    const float T = clamp(Band * Scale, -1.0f, 1.0f);

    const float3 Hue = (T < 0.0f) ? ColourB : ColourA;

    return lerp(EdgeColour, Hue, abs(T));
}

/** An authored vortex, added AFTER the shear rather than baked into the field
 *  that gets sheared.
 *
 *  This is not a convenience. Kinematic shear has no mechanism to sustain a
 *  vortex, so anything living inside the sheared field is eventually stretched
 *  into a filament and lost. Real spots survive because the inverse cascade
 *  feeds them continuously, and nothing here reproduces that. Exempting them
 *  from the shear is the honest fake, and it gives the right look besides: the
 *  spot persists while everything around it filaments past.
 *
 *  Centre is a unit direction. Drift its longitude by rotating Centre with
 *  GG_RotateZ at the spot's own band rate before calling. */
float GG_Spot(float3 N, float3 Centre, float Radius, float Strength)
{
    const float D = distance(N, normalize(Centre));

    return Strength * exp(-(D * D) / max(Radius * Radius, 1e-6f));
}

// ---------------------------------------------------------------------------
// Density
//
// COVERAGE IS 100% AND THAT SIMPLIFIES EVERYTHING.
//
// Terrestrial cloud shaders spend most of their complexity on coverage: where
// is there cloud and where is there sky. A gas giant has no holes. There is no
// threshold here, no coverage remap, no cloud/no-cloud decision. Density is
// solid below the deck and falls off above it, and every visible feature is
// RELIEF in that top surface rather than variation in opacity.
//
// WHICH IS WHY BAND DRIVES ALTITUDE, NOT OPACITY.
//
// Zones and belts are not bright and dark patches of the same material. They
// are high and low cloud decks: a zone is a raised deck of fresh ammonia ice,
// a belt is where the deck sits low and the line of sight reaches warmer,
// darker material underneath. Brightness is the consequence. Feeding Band into
// density would be modelling the symptom and would look flat under any lighting
// model, because there would be no actual geometry for light to interact with.
//
// The useful side effect is that all the detail work -- ridges, mottling,
// wisps, and the edge weighting that concentrates them on transitions -- lands
// in the height field. Under a march it becomes surface relief along the cliffs
// between decks, which is where a real gas giant's texture lives.
//
// COMPOSITION IS NOT A DENSITY TERM.
//
// Packed.a is a chemistry marker. It says what the material IS, not how much
// of it there is, so it belongs in extinction or scattering colour, not in the
// density field. It is passed straight through below rather than composited.
// Folding it in would make chemically distinct regions physically thinner,
// which is wrong and, worse, would look almost right.
// ---------------------------------------------------------------------------



/** Density at a point in the shell.
 *
 *  LocalPos here carries its true radius, unlike everywhere else in this file.
 *  The columnar field is evaluated at the normalized direction: the shell is
 *  thin enough that sampling at the true radius would shift UVW by far less
 *  than one lattice cell, so it would cost the same and change nothing.
 *
 *  Profile is float4(ShellThickness, TopSoftness, VortexThreshold, CoreRadius).
 *
 *  Returns:
 *    x  Density in [0,1]. Multiply by an extinction coefficient in the march.
 *    y  BAND MASK, for the colour ramp. NOT a density term.
 *    z  Pressure, for tinting vortices.
 *    w  Cloud top altitude, for shading relief and sphere-tracing the surface.
 *
 *  Note the march wants BandSharpness low -- around 0.8. High sharpness
 *  saturates Band toward 0 and 1, which turns the height field into two flat
 *  terraces joined by a cliff and throws away the relief this exists to
 *  produce. Sharpness was doing the work of contrast back when the output was
 *  brightness; here geometry does it instead. */
float4 GG_Density(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailFlow,
	SamplerState DetailSampler,
	Texture3D PackedDetail,
	SamplerState PackedSampler,
	float3 LocalPos,
	float PlanetRadius,
	float Time,
	float RigidRate,
	float4 Scales,
	float4 Warps,
	float4 Detail,
	float3 Layers,
	float BandSharpness,
	float ReliefThinning,
	float DetailVertical,
	float DetailErosion,
	float4 Relief,
	float4 Profile)
{
    const float Radius = length(LocalPos);
    const float3 Direction = LocalPos / max(Radius, 1e-4f);

	// Shell fraction. 0 at the deck base, 1 at the top of the modelled shell.
    const float Height = (Radius - PlanetRadius) / max(Profile.x, 1e-4f);

    const float4 Field = GG_Field(
		FlowField, FlowSampler, DetailFlow, DetailSampler, PackedDetail, PackedSampler,
		Direction, Time, RigidRate, Scales, Warps, Detail, Layers,
		Height, BandSharpness, ReliefThinning, DetailVertical, Relief, Profile.z);

    const float Top = Field.x;

	// Solid below the deck, fading above it. No lower bound is applied: the
	// interior is opaque and never seen, and fading density toward the base
	// would carve a hollow that only shows up as a wrong silhouette at the limb.
	//
	// Smoothstep rather than a linear ramp. The linear form is C0 at both ends,
	// and those two kinks are visible as hard lines at the cloud top and at the
	// point the deck goes solid -- the top one especially, since it is the
	// silhouette. Softening the curve buys more apparent softness than raising
	// TopSoftness does, and it costs nothing.
    const float Softness = max(Profile.y, 1e-4f);

	// THE DECK IS A VERTICAL ENVELOPE, NOT THE DENSITY.
	//
	// This is the distinction that decides whether the detail produces
	// structure or merely a rough surface. The envelope says how much cloud
	// COULD be here; the noise says how much there is. Multiplying them lets
	// the noise carve through the whole depth of the deck.
	//
	// The previous form modulated the deck by a signed term centred on one, so
	// deep inside the deck it saturated to solid and the detail could only ever
	// bite within the softness band. That is a rough surface on an opaque
	// shell, not cloud -- there was no vertical structure anywhere the envelope
	// was saturated, which is most of it.
    const float Envelope = 1.0f - smoothstep(Top - Softness, Top, Height);

	// DetailErosion mixes between the bare envelope and the envelope shaped by
	// the noise. At 0 the deck is smooth; at 1 the noise decides the density
	// everywhere within it.
	//
	// THE LERP FORM GIVES A DENSITY FLOOR OF (1 - DetailErosion), AND THAT IS
	// LOAD-BEARING HERE.
	//
	// There is no lower cloud shell. The deck is solid all the way down to the
	// backstop, and the ray is expected to terminate on TRANSMITTANCE long
	// before it reaches that radius. So the noise must never be able to open a
	// fully transparent column: it would let a ray run to the backstop, which
	// terminates opaque, and the result is a hard-edged hole punched through
	// the planet rather than a gap in the cloud.
	//
	// A multiply by the noise would allow exactly that. The lerp cannot,
	// whatever the noise does, as long as DetailErosion stays below 1. Keep it
	// there, and set DensityScale high enough that the floor saturates within a
	// few steps -- coverage is total, so the march should go opaque quickly and
	// spend its budget resolving the cloud TOP rather than the interior.
	//
	// Still strictly multiplicative against the envelope, which is what keeps
	// the marched span analytically thin: the envelope is exactly zero above
	// Top, so nothing the noise does can put density outside the bound
	// GG_TopBounds computed. An additive term could, and would be clipped by
	// the very bound that makes the march affordable.
    const float Density = Envelope * lerp(1.0f, Field.w, saturate(DetailErosion));

	// Field.z is the signed band, which is what the colour follows.
    return float4(Density, Field.z, Field.y, Top);
}

// ---------------------------------------------------------------------------
// Raymarch
//
// A SHELL, NOT A BOX.
//
// NoiseVolumePreview marches a box, and the note at the top of that file
// explains why: a tiling volume's domain is a cube and the seams it exists to
// find sit on the faces. Neither reason survives here. This field is not being
// validated for tiling, it is a spherical atmosphere, and the same file records
// that the galaxy marcher it descended from used a sphere for exactly this
// reason. So this goes back to a sphere, and specifically to a thin SHELL.
//
// THE SPAN IS ANALYTICALLY THIN, WHICH IS WHAT MAKES THIS AFFORDABLE.
//
// Each density sample here costs six texture fetches, against one for the box
// marcher. Stepping the whole atmosphere at that price would be hopeless.
//
// It is not necessary. GG_CloudTop is a bounded expression: Band and Pressure
// are both bounded, and the storm term is one-sided, so the highest and lowest
// the deck can possibly reach are known in closed form from Relief alone. Above
// TopMax there is provably nothing. Below TopMin minus the softness width,
// density is provably saturated and the view can never reach further.
//
// So the only span worth marching is the thin band between those two radii,
// and everything outside it is skipped without a single sample. This is the
// same argument the baker's brick bounds make -- bound the field, then use the
// bound to avoid sampling it -- applied to an analytic term rather than a baked
// one, which makes it exact rather than conservative.
//
// The consequence is that step budget buys resolution of the CLOUD TOP rather
// than of the atmosphere, which is the only thing visible at 100% coverage.
// ---------------------------------------------------------------------------

/** Interleaved gradient noise, from pixel coordinates.
 *
 *  Computed here rather than fed in, because the only thing a caller could
 *  usefully supply is the pixel position, and it is already in scope at the
 *  Custom node as Parameters.SvPosition. A separate node to produce this was a
 *  node whose entire job was to be forgotten and left at a constant, which
 *  silently disables the jitter and looks exactly like a marcher with too few
 *  steps.
 *
 *  IGN rather than a hash: its output is decorrelated between neighbouring
 *  pixels but low-discrepancy over any small block, so the error averages out
 *  across a few pixels instead of turning into salt-and-pepper. That matters
 *  because the thing being hidden is a sampling lattice, which is itself a
 *  block-scale artifact.
 *
 *  Spatial only. Adding View.StateFrameIndexMod8 to the dot product gives a
 *  temporally varying version, which is better under TAA and reads as flicker
 *  without it. */
float GG_Jitter(float2 PixelPos)
{
    return frac(52.9829189f * frac(dot(PixelPos, float2(0.06711056f, 0.00583715f))));
}

/** Ray against a sphere centred on the origin. Direction must be normalized.
 *
 *  Returns false when the ray misses. T0 may be negative, which means the
 *  origin is inside; callers clamp rather than reject, since a camera inside
 *  the shell is a normal case and not an error. */
bool GG_RaySphere(float3 Origin, float3 Dir, float Radius, out float T0, out float T1)
{
    const float B = dot(Origin, Dir);
    const float C = dot(Origin, Origin) - Radius * Radius;

    const float Disc = B * B - C;

    if (Disc < 0.0f)
    {
        T0 = 0.0f;
        T1 = 0.0f;
        return false;
    }

    const float S = sqrt(Disc);

    T0 = -B - S;
    T1 = -B + S;

    return true;
}

/** Closed-form bounds on the cloud top, used to make the marched span thin.
 *
 *  EVERY TERM IN GG_CloudTop HAS TO APPEAR HERE. An underestimate is not a
 *  conservative error, it is a clipping one: the outer radius comes from
 *  TopMax, so a term left out slices the tops off exactly the features it
 *  belongs to, and the result reads as a geometry bug rather than a bounds one.
 *
 *  Elevation is in [0,1], so the band contributes half of Relief.y either side
 *  of the base. Pressure is soft-saturated to [-1,1] sim-side, so it
 *  contributes the whole of Relief.z. ReliefScale never exceeds one, so
 *  ignoring it is conservative in the safe direction.
 *
 *  The detail is absent because it no longer moves the deck -- it modulates
 *  density beneath it, which cannot extend the surface upward and therefore
 *  cannot break this bound. That is the property that keeps the marched span
 *  analytically thin. */
void GG_TopBounds(float4 Relief, out float OutMin, out float OutMax)
{
    const float Span = 0.5f * abs(Relief.y) + abs(Relief.z);

    OutMin = Relief.x - Span;
    OutMax = Relief.x + Span + max(Relief.w, 0.0f);
}



/** Marches the cloud shell and integrates density.
 *
 *  InViewVec       Local camera vector, surface toward camera. CameraVector
 *                  through TransformVector [World -> Local].
 *  InCamPosLocal   Camera position in PLANET-LOCAL space, in the same units as
 *                  PlanetRadius. This is the ray origin, so a wrong value moves
 *                  the ray rather than merely biasing step size.
 *
 *  InDensityScale  Extinction multiplier. Because coverage is total, this wants
 *                  to be high enough that the march saturates within a few
 *                  steps of the deck; a low value produces a translucent planet
 *                  that reads as fog rather than as cloud.
 *
 *  InStepBudget    A budget, not a count. See the note in NoiseVolumePreview.
 *  InStepGrowth    Step growth across the marched span.
 *  InMaxSteps      Safety bound. Set to int(StepBudget) + 8.
 *  InPixelPos      Parameters.SvPosition.xy at the Custom node.
 *  InJitterAmount  0 disables the jitter, 1 applies it fully. Anything in
 *                  between mixes toward no offset.
 *
 *  Returns float4:
 *    x  Cloud top altitude at the visible surface. Use it for shading relief
 *       and for sphere-tracing the surface. Note what is NOT returned:
 *       accumulated emission. For a uniformly emitting medium the emission
 *       integral is identically 1 - Transmittance, so it carries no structure
 *       and is recoverable from y anyway.
 *    y  Transmittance. 1 - this is opacity.
 *    z  BAND, signed and unclamped. Feed to GG_BandColour. This is the same
 *       quantity the debug view draws as blue against orange.
 *    w  Pressure, for tinting vortices. Negative is cyclonic.
 *
 *  x and z are deliberately different quantities. x is the MAGNITUDE of the
 *  vorticity, turned into height: low at boundaries, high in band interiors.
 *  z is its SIGN, turned into a colour choice. The debug view shows both at
 *  once as one image, which makes them easy to mistake for one channel.
 *
 *  z and w are integrated against the same weights as the density itself, so
 *  each is the expected value over what the ray actually sees rather than a
 *  reading from an arbitrary step. That is what makes them usable as shading
 *  inputs: at the limb, where a ray grazes many columns, a single-step reading
 *  would flicker.
 *
 *  Packed into one float4 rather than returned through out parameters because
 *  the Custom node's Additional Outputs have to be declared by hand in the
 *  node's own array, and a mismatch there fails at shader compile with an
 *  undeclared identifier rather than anywhere useful. Four channels is what a
 *  single return can carry, and these are the four that matter. */
float4 GG_March(
	Texture2DArray FlowField,
	SamplerState FlowSampler,
	Texture3D DetailFlow,
	SamplerState DetailSampler,
	Texture3D PackedDetail,
	SamplerState PackedSampler,
	float3 InViewVec,
	float3 InCamPosLocal,
	float PlanetRadius,
	float Time,
	float RigidRate,
	float4 Scales,
	float4 Warps,
	float4 Detail,
	float3 Layers,
	float BandSharpness,
	float ReliefThinning,
	float DetailVertical,
	float DetailErosion,
	float4 Relief,
	float4 Profile,
	float InDensityScale,
	float InStepBudget,
	float InStepGrowth,
	int InMaxSteps,
	float2 InPixelPos,
	float InJitterAmount)
{
	// Miss value. Transmittance 1 means nothing was hit, which is what every
	// early exit below wants to report.
    const float4 Miss = float4(0.0f, 1.0f, 0.0f, 0.0f);

    const float3 Origin = InCamPosLocal;
    const float3 Dir = normalize(-InViewVec);

    const float Thickness = max(Profile.x, 1e-4f);
    const float Softness = max(Profile.y, 1e-4f);

	// -- Shell bounds -------------------------------------------------------

    float TopMin, TopMax;
    GG_TopBounds(Relief, TopMin, TopMax);

	// No margin above TopMax. Density is saturate((Top - Height)/Softness),
	// which is exactly zero at Height == Top, so there is provably nothing
	// there and padding it would only buy empty steps.
    const float OuterRadius = PlanetRadius + Thickness * TopMax;

	// Below this the field is saturated everywhere, so the ray can never see
	// past it. It is the backstop, not a surface.
	//
	// Profile.w overrides it when positive, which is what you want once a solid
	// core mesh is drawn inside: shrink this to sit just outside that mesh and
	// the atmosphere stops where the surface begins, instead of at whatever
	// radius the deck bound happened to imply.
    const float DerivedInner = PlanetRadius + Thickness * max(TopMin - Softness, 0.0f);
    const float InnerRadius = (Profile.w > 0.0f) ? Profile.w : DerivedInner;

    float TEnter, TExit;
    if (!GG_RaySphere(Origin, Dir, OuterRadius, TEnter, TExit))
    {
        return Miss;
    }

    if (TExit <= 0.0f)
    {
        return Miss;
    }

	// Camera inside the shell falls out of this clamp rather than needing its
	// own branch, and it matters under a span-relative step rule: the stretch
	// behind the viewer would otherwise be budgeted as if visible, spending
	// steps on nothing AND coarsening everything that is not.
    float TStart = max(TEnter, 0.0f);

	// Clip against the opaque interior. Anything past the near intersection is
	// fully dense by construction, so marching it would burn steps to confirm
	// what the bound already guarantees.
	//
	// Hitting it must also terminate the ray OPAQUE. Clipping the span without
	// zeroing transmittance is what produced a hard ring where grazing rays ran
	// out of march before they ran out of medium -- the geometry stopped but the
	// opacity did not, so the shell appeared to thin out against a boundary that
	// is physically solid. Anything at or below this radius is saturated by
	// construction, so the ray genuinely cannot see past it.
    bool bHitCore = false;

    float TInner0, TInner1;
    if (GG_RaySphere(Origin, Dir, InnerRadius, TInner0, TInner1))
    {
        if (TInner0 > TStart)
        {
            TExit = min(TExit, TInner0);
            bHitCore = true;
        }
    }

    if (TExit <= TStart)
    {
        return Miss;
    }

	// -- Step sizing --------------------------------------------------------

    const float Span = max(TExit - TStart, 1e-6f);
    const float BaseStep = Span / max(InStepBudget, 1.0f);

	// Step floor from the field rather than an authored distance. The finest
	// structure along the ray is the deck's own transition width, since nothing
	// resolves more finely than the softness over which density goes from zero
	// to one. Half of that is the Nyquist limit and stepping below it resolves
	// detail the field does not contain.
	//
	// This is the vertical limit. Horizontal detail is set by the texture
	// scales and matters only at the limb, where the ray runs nearly tangent
	// and crosses many columns per step -- which is also where step growth
	// hurts most, so keep growth modest if the terminator looks banded.
    const float MinStep = max(Thickness * Softness * 0.5f, 1e-5f);

    const float Growth = max(InStepGrowth, 0.0f);
    const float InvSpan = 1.0f / Span;

	// Shortens the first step only, offsetting each pixel's lattice so the
	// sampling grid does not read as banding. Costs no energy: the final step
	// clamps to the exit, so total path length is unchanged.
	//
	// Lerped from 1 rather than used directly, so an amount of 0 means no
	// offset at all rather than a zero-length first step.
    const float Noise = GG_Jitter(InPixelPos);
    const float FirstScale = clamp(lerp(1.0f, Noise, saturate(InJitterAmount)), 0.05f, 1.0f);

	// -- March --------------------------------------------------------------

    float Transmittance = 1.0f;
    float Emission = 0.0f;
    float BandAccum = 0.0f;
    float Pressure = 0.0f;
    float TopAccum = 0.0f;

    float T = TStart;
    float StepsTaken = 0.0f;

	[loop]
    for (int i = 0; i < InMaxSteps; i++)
    {
        const float Remaining = TExit - T;
        if (Remaining <= 1e-6f)
        {
            break;
        }

		// Growth runs on progress along the span, not distance from the camera,
		// which keeps the step count independent of where the viewer stands.
        const float T01 = saturate((T - TStart) * InvSpan);

        float StepLen = max(BaseStep * (1.0f + Growth * T01), MinStep);
        if (i == 0)
        {
            StepLen *= FirstScale;
        }
        StepLen = min(StepLen, Remaining);

        StepsTaken += 1.0f;

		// Midpoint sample. With steps that grow, sampling at the near edge
		// weights every interval by its own leading face and biases the
		// integral toward the camera.
        const float3 SamplePos = Origin + Dir * (T + StepLen * 0.5f);

        const float4 Field = GG_Density(
			FlowField, FlowSampler, DetailFlow, DetailSampler, PackedDetail, PackedSampler,
			SamplePos, PlanetRadius,
			Time, RigidRate, Scales, Warps, Detail, Layers,
			BandSharpness, ReliefThinning, DetailVertical, DetailErosion,
			Relief, Profile);

        const float Alpha = 1.0f - exp(-Field.x * InDensityScale * StepLen);
        const float Weight = Alpha * Transmittance;

        Emission += Weight;
        BandAccum += Weight * Field.y;
        Pressure += Weight * Field.z;
        TopAccum += Weight * Field.w;

        Transmittance *= 1.0f - Alpha;

        if (Transmittance < 0.001f)
        {
            break;
        }

        T += StepLen;
    }

	// Normalize the integrated properties by the weight that produced them, so
	// they stay in their own units instead of scaling with opacity. Guarded
	// because a ray that grazed the shell without accumulating anything has
	// nothing to report and must not divide by zero.
	// The march stopped against the solid interior, so nothing gets through.
    if (bHitCore)
    {
        Emission += Transmittance;
        Transmittance = 0.0f;
    }

    const float TotalWeight = max(Emission, 1e-4f);

    float TopOut = TopAccum / TotalWeight;

#if GG_DEBUG_STEPS
	TopOut = StepsTaken / max((float)InMaxSteps, 1.0f);
#endif

    return float4(
		TopOut,
		Transmittance,
		BandAccum / TotalWeight,
		Pressure / TotalWeight);
}
